<UserControl
    x:Class="Octave_Desktop.Controls.NowPlaying.QueuePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Octave.Core.Models"
    xmlns:converters="using:Octave_Desktop.Converters"
    mc:Ignorable="d"
    VerticalAlignment="Stretch"
    VerticalContentAlignment="Stretch">

    <UserControl.Resources>
        <converters:ArtworkPathConverter x:Key="ArtworkPathConverter" />
        <converters:DurationFormatConverter x:Key="DurationFormatConverter" />
        <!-- NP-20/NP-21: converters instead of x:Bind functions - the markup
             compiler cannot compile function bindings inside a DataTemplate. -->
        <converters:QueuePlayStateBrushConverter x:Key="QueuePlayStateBrushConverter" />
        <converters:ConditionalValueConverter x:Key="PlayPauseGlyphConverter"
                                              TrueValue="&#xE769;"
                                              FalseValue="&#xE768;"/>
    </UserControl.Resources>

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,14"
            VerticalAlignment="Stretch">
        <Grid RowDefinitions="Auto,*">
            <!-- Header Row -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE90B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
                    <TextBlock Text="Up Next Queue" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="ClearQueueButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="ClearQueueButton_Click"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Padding="8,4,8,4"
                        CornerRadius="6"
                        ToolTipService.ToolTip="Clear Queue (keeps current track)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="Clear All" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Empty State -->
            <StackPanel x:Name="EmptyQueueState"
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Padding="16,40"
                        Visibility="Collapsed">
                <FontIcon Glyph="&#xE90B;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Queue is empty" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Add tracks from your library or playlists to keep the music playing" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="280"/>
            </StackPanel>

            <!-- Scrollable Queue List inside Tile -->
            <ListView x:Name="QueueListView"
                      Grid.Row="1"
                      VerticalAlignment="Stretch"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollMode="Enabled"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      CanReorderItems="True"
                      CanDragItems="True"
                      AllowDrop="True"
                      ItemClick="QueueListView_ItemClick">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:QueueItem">
                        <!-- NP-20: the playing row gets a translucent accent tint and the
                             play button flips to a pause glyph (NP-21). Both re-evaluate
                             live because QueueItem.IsPlaying raises PropertyChanged. -->
                        <Grid Padding="8,8,4,8"
                              ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto"
                              CornerRadius="10"
                              Background="{Binding IsPlaying, Converter={StaticResource QueuePlayStateBrushConverter}, ConverterParameter=Background}">
                            <!-- Play / Pause Button (NP-21) -->
                            <Button Grid.Column="0"
                                    Click="ItemPlayButton_Click"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Padding="4"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="{Binding IsPlaying, Converter={StaticResource PlayPauseGlyphConverter}}"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="14"
                                          Foreground="{Binding IsPlaying, Converter={StaticResource QueuePlayStateBrushConverter}, ConverterParameter=Foreground}"/>
                            </Button>

                            <!-- Artwork (NP-19: binds the album artwork token resolved by
                                 the view model - NOT Track.SourceUri, technical audio path). -->
                            <Border Grid.Column="1" CornerRadius="6" Width="40" Height="40" Margin="0,0,12,0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Image Source="{x:Bind ArtworkUrl, Converter={StaticResource ArtworkPathConverter}, ConverterParameter=40, Mode=OneWay}" Stretch="UniformToFill"/>
                            </Border>

                            <!-- Track Info -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Track.Title}" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Track.ArtistName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Duration -->
                            <TextBlock Grid.Column="3"
                                       Text="{x:Bind Track.DurationSeconds, Converter={StaticResource DurationFormatConverter}}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,4,0"/>

                            <!-- Favorite Button -->
                            <Button Grid.Column="4"
                                    Click="ItemFavoriteButton_Click"
                                    Loaded="ItemFavoriteButton_Loaded"
                                    DataContextChanged="ItemFavoriteButton_DataContextChanged"
                                    Style="{StaticResource GhostIconButtonStyle}"
                                    ToolTipService.ToolTip="Favorite"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEB51;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </Button>

                            <!-- UI-NP-02: per-row remove, mirroring the sidebar queue -->
                            <Button Grid.Column="5"
                                    Click="ItemRemoveButton_Click"
                                    Style="{StaticResource GhostIconButtonStyle}"
                                    ToolTipService.ToolTip="Remove from queue"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Border>
</UserControl>
