<UserControl
    x:Class="Octave_Desktop.Controls.NowPlaying.CreditsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Octave.Core.Models"
    xmlns:converters="using:Octave_Desktop.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:ArtworkPathConverter x:Key="ArtworkPathConverter" />
    </UserControl.Resources>

    <StackPanel Spacing="16">
        <!-- Tile 1: Artists -->
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,14">
            <StackPanel Spacing="12">
                <TextBlock Text="ARTISTS" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" CharacterSpacing="80"/>

                <ItemsControl x:Name="ArtistsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ArtistDisplayItem">
                            <Button Click="ArtistItem_Click"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Padding="4"
                                    CornerRadius="6"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Ellipse Width="48" Height="48" Grid.Column="0" Margin="0,0,16,0">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{x:Bind ArtworkUrl, Converter={StaticResource ArtworkPathConverter}, ConverterParameter=Artist}" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Tile 2: Album -->
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0"
                Visibility="{x:Bind HasTextVisibility(AlbumTitle), Mode=OneWay}">
            <Button Click="AlbumTile_Click"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="16,14"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left">
                <StackPanel Spacing="12">
                    <TextBlock Text="ALBUM" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" CharacterSpacing="80"/>

                    <Grid ColumnDefinitions="Auto,*">
                        <Border CornerRadius="6" Width="56" Height="56" Grid.Column="0" Margin="0,0,16,0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Image Source="{x:Bind AlbumArtworkUrl, Mode=OneWay, Converter={StaticResource ArtworkPathConverter}, ConverterParameter=Small}" Stretch="UniformToFill"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{x:Bind AlbumTitle, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind AlbumYearText(AlbumYear), Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind AlbumYearVisibility(AlbumYear), Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Button>
        </Border>

        <!-- Tile 3: Audiophile Signal Path & Audio Info -->
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,14">
            <StackPanel Spacing="12">
                <!-- Header: Title & Badges -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="AUDIOPHILE SIGNAL PATH" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" CharacterSpacing="80" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Quality Tier Badge (HI-RES / LOSSLESS / AAC / MP3) -->
                        <Border Background="#20FFFFFF"
                                BorderBrush="{x:Bind QualityBadgeBrush(QualityDetails), Mode=OneWay}"
                                BorderThickness="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center"
                                Visibility="{x:Bind QualityBadgeVisibility(QualityDetails), Mode=OneWay}">
                            <TextBlock Text="{x:Bind QualityBadgeText(QualityDetails), Mode=OneWay}"
                                       FontSize="10" FontWeight="Bold" Foreground="{x:Bind QualityBadgeBrush(QualityDetails), Mode=OneWay}" VerticalAlignment="Center" />
                        </Border>

                        <!-- Bit-Matched Direct Badge -->
                        <Border Background="#26FFD54F" BorderBrush="#80FFD54F" BorderThickness="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center"
                                Visibility="{x:Bind BitMatchedVisibility(QualityDetails), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#FFD54F" />
                                <TextBlock Text="BIT-MATCHED DIRECT" FontSize="9" FontWeight="Bold" Foreground="#FFD54F" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <MenuFlyoutSeparator Margin="0,0,0,2" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- Stream Source Section -->
                <Grid ColumnDefinitions="*,*" RowSpacing="10" ColumnSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Stream (Source) Format -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                        <TextBlock Text="STREAM (SOURCE)" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind FormatText(QualityDetails), Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#00E676" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ChannelsText(QualityDetails), Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Codec / Container -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                        <TextBlock Text="CODEC / FORMAT" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{x:Bind CodecFormatText(QualityDetails), Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Decoder Engine -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                        <TextBlock Text="DECODER ENGINE" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{x:Bind DecoderEngineText(QualityDetails), Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Resampling State -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                        <TextBlock Text="RESAMPLING STATE" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{x:Bind ResamplingStatusText(QualityDetails), Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#FFD54F" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <MenuFlyoutSeparator Margin="0,2,0,2" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- Hardware Output Section -->
                <Grid ColumnDefinitions="*,*" RowSpacing="10" ColumnSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Active Output Device -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                        <TextBlock Text="ACTIVE OUTPUT" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind OutputDeviceGlyph(QualityDetails), Mode=OneWay}" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind OutputDeviceNameText(QualityDetails), Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Device Category / DAC Type -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                        <TextBlock Text="DEVICE CATEGORY / DAC" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{x:Bind OutputDeviceCategoryText(QualityDetails), Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#00E676" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Hardware Output Format -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                        <TextBlock Text="HARDWARE OUTPUT FORMAT" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{x:Bind OutputDeviceQualityText(QualityDetails), Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- DSP / Processing Status -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                        <TextBlock Text="DSP / PROCESSING" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind DspStatusText(QualityDetails), Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Tile 4: Track & Tag Properties -->
        <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18">
            <StackPanel Spacing="14">
                <TextBlock Text="TRACK &amp; TAG PROPERTIES" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" CharacterSpacing="80"/>

                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="GENRE" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind GenreDisplay(TrackGenre), Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="TRACK / DISC" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind TrackAndDiscText(TrackNumber, DiscNumber), Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="REPLAYGAIN" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ReplayGainDisplay(ReplayGain), Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="BIT DEPTH / CHANNELS" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind BitDepthAndChannelsText(QualityDetails), Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="4" Visibility="{x:Bind HasTextVisibility(SourceUri), Mode=OneWay}">
                    <TextBlock Text="FILE LOCATION" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind SourceUri, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
