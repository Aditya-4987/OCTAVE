<UserControl
    x:Class="Octave_Desktop.Controls.NowPlaying.CreditsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Octave.Core.Models"
    xmlns:converters="using:Octave_Desktop.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:ArtworkPathConverter x:Key="ArtworkPathConverter" />
    </UserControl.Resources>

    <StackPanel Spacing="16">
        <!-- Tile 1: Artists -->
        <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18">
            <StackPanel Spacing="12">
                <TextBlock Text="ARTISTS" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" CharacterSpacing="80"/>

                <ItemsControl x:Name="ArtistsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ArtistDisplayItem">
                            <Button Click="ArtistItem_Click"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Padding="4"
                                    CornerRadius="8"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Ellipse Width="48" Height="48" Grid.Column="0" Margin="0,0,16,0">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{x:Bind ArtworkUrl, Converter={StaticResource ArtworkPathConverter}, ConverterParameter=Artist}" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Tile 2: Album -->
        <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="0"
                Visibility="{x:Bind HasTextVisibility(AlbumTitle), Mode=OneWay}">
            <Button Click="AlbumTile_Click"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="18"
                    CornerRadius="14"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left">
                <StackPanel Spacing="12">
                    <TextBlock Text="ALBUM" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" CharacterSpacing="80"/>

                    <Grid ColumnDefinitions="Auto,*">
                        <Border CornerRadius="8" Width="56" Height="56" Grid.Column="0" Margin="0,0,16,0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Image Source="{x:Bind AlbumArtworkUrl, Mode=OneWay, Converter={StaticResource ArtworkPathConverter}, ConverterParameter=Small}" Stretch="UniformToFill"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{x:Bind AlbumTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind AlbumYearText(AlbumYear), Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind AlbumYearVisibility(AlbumYear), Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Button>
        </Border>

        <!-- Tile 3: Audio Info -->
        <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18">
            <StackPanel Spacing="14">
                <TextBlock Text="AUDIO INFO" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" CharacterSpacing="80"/>

                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="STREAM FORMAT" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind FormatText(QualityDetails), Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="OUTPUT DEVICE" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind OutputDeviceNameText(QualityDetails), Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="DECODER ENGINE" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind DecoderEngineText(QualityDetails), Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="DAC OUTPUT FORMAT" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind OutputDeviceQualityText(QualityDetails), Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
