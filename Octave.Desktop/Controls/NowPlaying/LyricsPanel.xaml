<UserControl
    x:Class="Octave_Desktop.Controls.NowPlaying.LyricsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Octave.Core.Models"
    mc:Ignorable="d"
    VerticalAlignment="Stretch">

    <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24,16,24,20"
            VerticalAlignment="Stretch">
        <Grid RowDefinitions="Auto,*" VerticalAlignment="Stretch">
            <!-- Toolbar (UI-NP-06): lyric mode selector (Synced / Static) + lyric sync nudge + copy. Shown only when
                 there are lyrics on screen to act on. -->
            <Grid Grid.Row="0" x:Name="ToolbarRow" Margin="-8,0,-8,10" Visibility="Collapsed">
                <ComboBox x:Name="LyricModeComboBox"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          FontSize="12"
                          Padding="10,4"
                          MinHeight="28"
                          CornerRadius="6"
                          SelectionChanged="LyricModeComboBox_SelectionChanged">
                    <ComboBoxItem x:Name="SyncedModeItem" Content="Synced Lyrics" FontSize="12" />
                    <ComboBoxItem x:Name="StaticModeItem" Content="Static Lyrics" FontSize="12" />
                </ComboBox>

                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Sync Controls (Visible ONLY in Synced Lyrics mode) -->
                    <StackPanel x:Name="SyncControlsPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="OffsetIndicator"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Margin="0,0,4,0"
                                   Visibility="Collapsed" />
                        <!-- NF-25: appears only while the user has scrolled the lyrics
                             off the auto-follow position - clicking re-syncs. -->
                        <Button x:Name="SyncLyricsButton"
                                Click="SyncLyricsButton_Click"
                                Visibility="Collapsed"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Padding="7,3,7,3"
                                CornerRadius="6"
                                ToolTipService.ToolTip="Back to the current line (resume auto-scroll)">
                            <FontIcon Glyph="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                      Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
                        </Button>
                        <Button x:Name="DecreaseOffsetButton"
                                Click="DecreaseOffsetButton_Click"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Padding="7,3,7,3"
                                CornerRadius="6"
                                ToolTipService.ToolTip="Shift lyrics 500 ms earlier">
                            <FontIcon Glyph="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Button>
                        <Button x:Name="IncreaseOffsetButton"
                                Click="IncreaseOffsetButton_Click"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Padding="7,3,7,3"
                                CornerRadius="6"
                                ToolTipService.ToolTip="Shift lyrics 500 ms later">
                            <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Button>
                        <!-- NF-26: undo any +/- nudges back to 0 in one click. -->
                        <Button x:Name="ResetOffsetButton"
                                Click="ResetOffsetButton_Click"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Padding="7,3,7,3"
                                CornerRadius="6"
                                ToolTipService.ToolTip="Reset sync offset to 0">
                            <FontIcon Glyph="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Button>
                    </StackPanel>

                    <!-- Copy button: always accessible when lyrics exist -->
                    <Button x:Name="CopyLyricsButton"
                            Click="CopyLyricsButton_Click"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="7,3,7,3"
                            CornerRadius="6"
                            Margin="6,0,0,0"
                            ToolTipService.ToolTip="Copy lyrics to clipboard">
                        <FontIcon Glyph="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" VerticalAlignment="Stretch">
                <!-- Loading State -->
                <StackPanel x:Name="LoadingContainer" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Visibility="Collapsed">
                    <ProgressRing IsActive="True" Width="36" Height="36" />
                    <TextBlock Text="Searching lyrics..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Unavailable State -->
                <StackPanel x:Name="UnavailableContainer" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Lyrics unavailable" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Unsynced Lyrics View -->
                <ScrollViewer x:Name="UnsyncedScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              VerticalScrollMode="Enabled"
                              HorizontalScrollMode="Disabled"
                              Visibility="Collapsed">
                    <TextBlock x:Name="UnsyncedTextBlock"
                               FontSize="18"
                               LineHeight="30"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap"/>
                </ScrollViewer>

                <!-- Synced Lyrics View.
                     CRIT-05: a virtualizing ListView recycled these containers and left
                     _lineElements pointing at dead elements. Lyrics lists are small (<200
                     lines), so a plain non-virtualized ItemsControl keeps every container
                     alive for its whole lifetime - the element list can never go stale. -->
                <ScrollViewer x:Name="SyncedScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              VerticalScrollMode="Enabled"
                              HorizontalScrollMode="Disabled"
                              Padding="0,12,0,12"
                              ViewChanged="SyncedScrollViewer_ViewChanged"
                              PointerWheelChanged="SyncedScrollViewer_PointerWheelChanged"
                              Visibility="Collapsed">
                    <ItemsControl x:Name="SyncedItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:LyricLine">
                                <TextBlock Text="{x:Bind Text}"
                                           FontSize="18"
                                           FontWeight="Medium"
                                           Margin="0,8,0,8"
                                           TextWrapping="Wrap"
                                           Loaded="LyricLineTextBlock_Loaded"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
