<UserControl
    x:Class="Octave_Desktop.Controls.NowPlaying.LyricsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Octave.Core.Models"
    mc:Ignorable="d"
    VerticalAlignment="Stretch">

    <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            BorderBrush="#25FFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24"
            VerticalAlignment="Stretch">
        <Grid VerticalAlignment="Stretch">
            <!-- Loading State -->
            <StackPanel x:Name="LoadingContainer" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="36" Height="36" />
                <TextBlock Text="Searching lyrics..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Unavailable State -->
            <StackPanel x:Name="UnavailableContainer" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed">
                <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Lyrics unavailable" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Unsynced Lyrics View -->
            <ScrollViewer x:Name="UnsyncedScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          VerticalScrollMode="Enabled"
                          HorizontalScrollMode="Disabled"
                          Visibility="Collapsed">
                <TextBlock x:Name="UnsyncedTextBlock"
                           FontSize="18"
                           LineHeight="30"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           TextWrapping="Wrap"/>
            </ScrollViewer>

            <!-- Synced Lyrics View (Virtualized via ListView with bounded scrolling) -->
            <ListView x:Name="SyncedListView"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      Padding="0,20,0,20"
                      ShowsScrollingPlaceholders="False"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollMode="Enabled"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:LyricLine">
                        <TextBlock Text="{x:Bind Text}"
                                   FontSize="20"
                                   FontWeight="Medium"
                                   Margin="0,8,0,8"
                                   TextWrapping="Wrap"
                                   Loaded="LyricLineTextBlock_Loaded"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Border>
</UserControl>
