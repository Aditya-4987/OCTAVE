<ContentDialog
    x:Class="Octave_Desktop.Controls.LibraryEnrichmentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Octave_Desktop.ViewModels"
    mc:Ignorable="d"
    Title="Smart Library Enrichment"
    CloseButtonText="Close"
    DefaultButton="None"
    FullSizeDesired="False">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <!-- Semantic status colors were hardcoded neon-on-dark (#00FF66 family)
                 and became unreadable in light theme - each now has both variants. -->
            <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Default">
                <SolidColorBrush x:Key="OCTAVE_StatusSuccess" Color="#6CCB5F" />
                <SolidColorBrush x:Key="OCTAVE_StatusWarning" Color="#FFB900" />
                <SolidColorBrush x:Key="OCTAVE_StatusDanger" Color="#FF99A4" />
                <SolidColorBrush x:Key="OCTAVE_StatusMuted" Color="#9A9A9A" />
                <SolidColorBrush x:Key="OCTAVE_WarningChipBg" Color="#33FFAA00" />
                <SolidColorBrush x:Key="OCTAVE_LocalPanelBg" Color="#10FFFFFF" />
                <SolidColorBrush x:Key="OCTAVE_ProposedPanelBg" Color="#156CCB5F" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="OCTAVE_StatusSuccess" Color="#0F7B3D" />
                <SolidColorBrush x:Key="OCTAVE_StatusWarning" Color="#9A6700" />
                <SolidColorBrush x:Key="OCTAVE_StatusDanger" Color="#C42B1C" />
                <SolidColorBrush x:Key="OCTAVE_StatusMuted" Color="#616161" />
                <SolidColorBrush x:Key="OCTAVE_WarningChipBg" Color="#229A6700" />
                <SolidColorBrush x:Key="OCTAVE_LocalPanelBg" Color="#0A000000" />
                <SolidColorBrush x:Key="OCTAVE_ProposedPanelBg" Color="#140F7B3D" />
            </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style TargetType="TextBlock" x:Key="MetricHeaderStyle">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <Style TargetType="TextBlock" x:Key="MetricValueStyle">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <Grid MinWidth="720" MaxWidth="800" MaxHeight="620" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP BAR: ACTIONS & DESCRIPTION -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Online Metadata, Artwork &amp; Lyrics Enrichment"
                           FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock Text="Analyzes tracks against mandatory safety gates before writing."
                           FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Preview Changes (Dry Run)"
                        Command="{x:Bind ViewModel.StartPreviewDryRunCommand}"
                        IsEnabled="{x:Bind BoolToInverted(ViewModel.IsScanning), Mode=OneWay}" />
                <Button Content="Apply Safe Changes"
                        Command="{x:Bind ViewModel.ApplySafeChangesCommand}"
                        IsEnabled="{x:Bind BoolToInverted(ViewModel.IsScanning), Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" FontWeight="SemiBold" />
                <Button Content="Cancel"
                        Command="{x:Bind ViewModel.CancelScanCommand}"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.IsScanning), Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- LIVE PROGRESS BAR & STATUS -->
        <Border Grid.Row="1" Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.CurrentOperation, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" />
                        <TextBlock Text="{x:Bind ViewModel.CurrentTrackTitle, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{x:Bind FormatProgressPercent(ViewModel.ProgressPercentage), Mode=OneWay}"
                               FontSize="14" FontWeight="Bold" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" VerticalAlignment="Center" />
                </Grid>

                <ProgressBar Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}" Minimum="0" Maximum="100" Height="6" CornerRadius="3" />

                <!-- METRICS GRID -->
                <Grid ColumnDefinitions="*,*,*,*,*,*" Margin="0,4,0,0">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="ANALYZED" Style="{StaticResource MetricHeaderStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ScannedTracks, Mode=OneWay}" Style="{StaticResource MetricValueStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="SAFE MATCHES" Style="{StaticResource MetricHeaderStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.SafeReadyCount, Mode=OneWay}" Style="{StaticResource MetricValueStyle}"
                                   Foreground="{ThemeResource OCTAVE_StatusSuccess}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="COMPLETE" Style="{StaticResource MetricHeaderStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.AlreadyCompleteCount, Mode=OneWay}" Style="{StaticResource MetricValueStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="2">
                        <TextBlock Text="NEEDS REVIEW" Style="{StaticResource MetricHeaderStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.NeedsReviewCount, Mode=OneWay}" Style="{StaticResource MetricValueStyle}"
                                   Foreground="{ThemeResource OCTAVE_StatusWarning}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Spacing="2">
                        <TextBlock Text="NO MATCH" Style="{StaticResource MetricHeaderStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.NoMatchCount, Mode=OneWay}" Style="{StaticResource MetricValueStyle}"
                                   Foreground="{ThemeResource OCTAVE_StatusMuted}" />
                    </StackPanel>
                    <StackPanel Grid.Column="5" Spacing="2">
                        <TextBlock Text="FAILED" Style="{StaticResource MetricHeaderStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.FailedCount, Mode=OneWay}" Style="{StaticResource MetricValueStyle}"
                                   Foreground="{ThemeResource OCTAVE_StatusDanger}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- REVIEW QUEUE & SUMMARY VIEW -->
        <Border Grid.Row="2" Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" MinHeight="220">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="Ambiguous Matches / Review Queue" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind FormatQueueCount(ViewModel.ReviewQueue.Count), Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" VerticalAlignment="Center" />
                </Grid>

                <TextBlock Grid.Row="1" Text="No tracks currently requiring manual review."
                           Visibility="{x:Bind BoolToVisibilityInverted(ViewModel.HasReviewItems), Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                              Visibility="{x:Bind BoolToVisibility(ViewModel.HasReviewItems), Mode=OneWay}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ReviewQueue, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReviewItemViewModel">
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12" Margin="0,4,0,4">
                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- HEADER & CONFIDENCE -->
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind LocalTitle}" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" />
                                                <TextBlock Text="—" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind LocalArtist}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{ThemeResource OCTAVE_WarningChipBg}" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{x:Bind ConfidencePercentageText}" Foreground="{ThemeResource OCTAVE_StatusWarning}" FontWeight="SemiBold" FontSize="11" />
                                            </Border>
                                        </Grid>

                                        <!-- SIDE-BY-SIDE LOCAL VS CANDIDATE -->
                                        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
                                            <Border Grid.Column="0" Background="{ThemeResource OCTAVE_LocalPanelBg}" CornerRadius="6" Padding="8">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="CURRENT LOCAL TAGS" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Text="{x:Bind FormattedLocalSummary}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind LocalDurationText}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1" Background="{ThemeResource OCTAVE_ProposedPanelBg}" CornerRadius="6" Padding="8">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="PROPOSED ONLINE MATCH" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource OCTAVE_StatusSuccess}" />
                                                    <TextBlock Text="{x:Bind FormattedProposedSummary}" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind ProposedDurationText}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- ACTIONS -->
                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{x:Bind StatusText, Mode=OneWay}"
                                                       FontSize="11" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Button Content="Apply Candidate" Command="{x:Bind ApplyCandidateCommand}"
                                                        IsEnabled="{x:Bind IsNotResolved, Mode=OneWay}"
                                                        Style="{StaticResource AccentButtonStyle}" />
                                                <Button Content="Skip" Command="{x:Bind SkipCommand}"
                                                        IsEnabled="{x:Bind IsNotResolved, Mode=OneWay}" />
                                                <Button Content="Never Ask Again" Command="{x:Bind NeverAskAgainCommand}"
                                                        IsEnabled="{x:Bind IsNotResolved, Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
