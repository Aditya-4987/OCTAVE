<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Octave_Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Octave_Desktop">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <converters:FavoriteGlyphConverter x:Key="FavoriteGlyphConverter" xmlns:converters="using:Octave_Desktop.Converters" />
            <converters:FavoriteBrushConverter x:Key="FavoriteBrushConverter" xmlns:converters="using:Octave_Desktop.Converters" />
            <converters:FavoriteToolTipConverter x:Key="FavoriteToolTipConverter" xmlns:converters="using:Octave_Desktop.Converters" />

            <!-- NF-14: three "global brushes" hardcoded dark-theme colors
                 (#181818 / #282828 / #121212), so every surface referencing them -
                 the shared card style, the player bar, the detail-page banners -
                 stayed dark after a light-theme switch. They are deleted; consumers
                 now resolve theme resources directly. -->

            <ThemeShadow x:Key="SharedShadow" />

            <Style x:Key="StandardCardStyle" TargetType="Grid">
                <!-- UI-HP-04/NF-14: themed card surface + stroke instead of the
                     hardcoded #181818 background and #2A2A2A border. -->
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <!-- Add a transition for smooth scale/color changes -->
                <Setter Property="Transitions">
                    <Setter.Value>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CleanGridViewItemStyle" TargetType="GridViewItem">
                <Setter Property="Margin" Value="0,0,16,16" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewItem">
                            <ListViewItemPresenter
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                Control.IsTemplateFocusTarget="True"
                                FocusVisualMargin="{TemplateBinding FocusVisualMargin}"
                                SelectionCheckMarkVisualEnabled="False"
                                CheckBrush="Transparent"
                                CheckBoxBrush="Transparent"
                                DragBackground="Transparent"
                                DragForeground="Transparent"
                                FocusBorderBrush="Transparent"
                                FocusSecondaryBorderBrush="Transparent"
                                PlaceholderBackground="Transparent"
                                PointerOverBackground="Transparent"
                                PointerOverBackgroundMargin="0"
                                SelectedBackground="Transparent"
                                SelectedForeground="Transparent"
                                SelectedPointerOverBackground="Transparent"
                                SelectedPressedBackground="Transparent"
                                PressedBackground="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Circular Play Button Style -->
            <Style x:Key="PrimaryPlayButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource SystemControlHighlightAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="CornerRadius" Value="28" />
                <Setter Property="Width" Value="56" />
                <Setter Property="Height" Value="56" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="SmallPlayButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource SystemControlHighlightAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="GhostIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
