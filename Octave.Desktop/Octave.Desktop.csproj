<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Octave_Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <Platforms>x64;x86;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory Condition="'%(Filename)%(Extension)' == 'test.mp3' and '$(Configuration)' != 'Debug'">Never</CopyToPublishDirectory>
      <CopyToPublishDirectory Condition="'%(Filename)%(Extension)' != 'test.mp3' or '$(Configuration)' == 'Debug'">PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
      <Content Include="bass.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <!-- Optional BASS decoder add-ons (bassflac.dll, bassopus.dll, bass_aac.dll,
           bassalac.dll, basswma.dll, bassdsd.dll, bass_ape.dll). Any DLL placed in
           BassPlugins\ is copied flat next to bass.dll so the engine can load it.
           The folder may be empty - the glob then matches nothing and the build
           is unaffected. -->
      <Content Include="BassPlugins\*.dll">
        <Link>%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Octave.Core\Octave.Core.csproj" />
  </ItemGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

  <!-- WinUI 3 Unpackaged Publish Target: Guarantees PRI, XBF, and Assets are published for standalone portable deployment -->
  <Target Name="PublishWinUIAppArtifacts" AfterTargets="Publish">
    <ItemGroup>
      <_PriFiles Include="$(TargetDir)$(TargetName).pri" Condition="Exists('$(TargetDir)$(TargetName).pri')" />
      <_RootXbfFiles Include="$(TargetDir)*.xbf" />
      <_ViewsXbfFiles Include="$(TargetDir)Views\**\*.xbf" />
      <_ControlsXbfFiles Include="$(TargetDir)Controls\**\*.xbf" />
      <_ProjectAssets Include="$(MSBuildProjectDirectory)\Assets\**\*" Exclude="$(MSBuildProjectDirectory)\Assets\test.mp3" Condition="'$(Configuration)' != 'Debug'" />
      <_ProjectAssets Include="$(MSBuildProjectDirectory)\Assets\**\*" Condition="'$(Configuration)' == 'Debug'" />
    </ItemGroup>

    <!-- Copy PRI file as Octave.Desktop.pri and resources.pri to ensure both naming conventions resolve -->
    <Copy SourceFiles="@(_PriFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PriFiles)" DestinationFiles="$(PublishDir)resources.pri" SkipUnchangedFiles="true" />

    <!-- Copy root XBF files (App.xbf, MainWindow.xbf, MiniPlayerWindow.xbf) -->
    <Copy SourceFiles="@(_RootXbfFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />

    <!-- Copy subfolder XBF files (Views, Controls) preserving relative paths -->
    <Copy SourceFiles="@(_ViewsXbfFiles)" DestinationFiles="@(_ViewsXbfFiles->'$(PublishDir)Views\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ControlsXbfFiles)" DestinationFiles="@(_ControlsXbfFiles->'$(PublishDir)Controls\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

    <!-- Copy Assets folder with all branding, icons, and placeholder art -->
    <Copy SourceFiles="@(_ProjectAssets)" DestinationFiles="@(_ProjectAssets->'$(PublishDir)Assets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

    <!-- Copy Setup scripts and documentation to PublishDir for portable distribution -->
    <ItemGroup>
      <_SetupFiles Include="$(MSBuildProjectDirectory)\..\setup.cmd;$(MSBuildProjectDirectory)\..\setup.ps1;$(MSBuildProjectDirectory)\..\SETUP.md;$(MSBuildProjectDirectory)\..\setup.md" />
    </ItemGroup>
    <Copy SourceFiles="@(_SetupFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('%(FullPath)')" />
  </Target>
</Project>