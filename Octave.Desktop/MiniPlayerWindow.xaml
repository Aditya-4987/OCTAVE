<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Octave_Desktop.MiniPlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Octave_Desktop.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    Title="Octave Mini">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="14" RowSpacing="8">
        <Grid.Resources>
            <converters:ArtworkPathConverter x:Key="ArtworkPathConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: art / metadata / transport / expand -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="56" Height="56">
                <Border CornerRadius="6" Background="{ThemeResource SystemControlHighlightAccentBrush}" Opacity="0.15">
                    <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" />
                </Border>
                <Border CornerRadius="6">
                    <Image Source="{Binding ViewModel.CurrentArtworkUrl, Converter={StaticResource ArtworkPathConverter}}" Stretch="UniformToFill" />
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.TrackTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind ViewModel.ArtistName, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Command="{x:Bind ViewModel.PreviousCommand}" Background="Transparent" BorderBrush="Transparent" Padding="6" ToolTipService.ToolTip="Previous">
                    <FontIcon Glyph="&#xE892;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="14" />
                </Button>
                <Button Command="{x:Bind ViewModel.PlayCommand}" Visibility="{x:Bind BoolToVisibilityNegation(ViewModel.IsPlaying), Mode=OneWay}" Background="Transparent" BorderBrush="Transparent" Padding="6" ToolTipService.ToolTip="Play">
                    <FontIcon Glyph="&#xE768;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="16" />
                </Button>
                <Button Command="{x:Bind ViewModel.PauseCommand}" Visibility="{x:Bind BoolToVisibility(ViewModel.IsPlaying), Mode=OneWay}" Background="Transparent" BorderBrush="Transparent" Padding="6" ToolTipService.ToolTip="Pause">
                    <FontIcon Glyph="&#xE769;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="16" />
                </Button>
                <Button Command="{x:Bind ViewModel.NextCommand}" Background="Transparent" BorderBrush="Transparent" Padding="6" ToolTipService.ToolTip="Next">
                    <FontIcon Glyph="&#xE893;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="14" />
                </Button>
            </StackPanel>

            <Button Grid.Column="3" Click="Expand_Click" Background="Transparent" BorderBrush="Transparent" Padding="6"
                    VerticalAlignment="Center" ToolTipService.ToolTip="Back to main window">
                <FontIcon Glyph="&#xE740;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="14" />
            </Button>
        </Grid>

        <!-- Row 1: seek bar -->
        <Grid Grid.Row="1" ColumnSpacing="8" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind FormatSeconds(ViewModel.PositionSeconds), Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Width="36" TextAlignment="Right" />
            <Slider Grid.Column="1" x:Name="MiniSeek" Minimum="0"
                    Maximum="{x:Bind ViewModel.SliderMaximum, Mode=OneWay}"
                    Value="{x:Bind ViewModel.PositionSeconds, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.IsTimelineEnabled, Mode=OneWay}"
                    StepFrequency="0.1"
                    IsThumbToolTipEnabled="False" VerticalAlignment="Center" Margin="0,-8,0,-8"
                    PointerWheelChanged="MiniSeek_PointerWheelChanged" KeyDown="MiniSeek_KeyDown" />
            <TextBlock Grid.Column="2" Text="{x:Bind FormatSeconds(ViewModel.DurationSeconds), Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Width="36" TextAlignment="Left" />
        </Grid>
    </Grid>
</Window>
