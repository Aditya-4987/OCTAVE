<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Octave_Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Octave_Desktop"
    xmlns:converters="using:Octave_Desktop.Converters"
    xmlns:models="using:Octave.Core.Models"
    xmlns:controls="using:Octave.Desktop.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Octave.Desktop"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" MinWidth="750" MinHeight="500">

        <Grid.Resources>
            <converters:ArtworkPathConverter x:Key="ArtworkPathConverter" />
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="P" Invoked="Accel_PlayPause" />
            <KeyboardAccelerator Modifiers="Control" Key="Right" Invoked="Accel_Next" />
            <KeyboardAccelerator Modifiers="Control" Key="Left" Invoked="Accel_Previous" />
            <KeyboardAccelerator Modifiers="Control" Key="Up" Invoked="Accel_VolumeUp" />
            <KeyboardAccelerator Modifiers="Control" Key="Down" Invoked="Accel_VolumeDown" />
            <KeyboardAccelerator Modifiers="Control" Key="M" Invoked="Accel_Mute" />
        </Grid.KeyboardAccelerators>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Ambient Album Artwork Background -->
        <Grid Grid.RowSpan="3">
            <Image Source="{Binding ViewModel.CurrentArtworkUrl, Converter={StaticResource ArtworkPathConverter}, ConverterParameter=Large}" Stretch="UniformToFill" Opacity="0.3" ImageOpened="BackgroundImage_ImageOpened" />
            <Border>
                <Border.Background>
                    <AcrylicBrush TintColor="{ThemeResource SystemAltHighColor}" TintOpacity="0.85" FallbackColor="Transparent" />
                </Border.Background>
            </Border>
        </Grid>

        <TitleBar x:Name="AppTitleBar" Title="Octave.Desktop" Grid.Row="0">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <SplitView Grid.Row="1" IsPaneOpen="{x:Bind ViewModel.IsNowPlayingOpen, Mode=TwoWay}" DisplayMode="Overlay" PanePlacement="Right" OpenPaneLength="360">
            <SplitView.Content>
                <NavigationView x:Name="NavView" 
                                PaneDisplayMode="Auto"
                                ItemInvoked="NavigationView_ItemInvoked"
                                BackRequested="NavigationView_BackRequested"
                                IsSettingsVisible="True">
                    <NavigationView.Header>
                        <AutoSuggestBox x:Name="GlobalSearchBox" 
                                        PlaceholderText="Search your library..." 
                                        QueryIcon="Find" 
                                        Width="300" 
                                        HorizontalAlignment="Left" 
                                        ItemsSource="{x:Bind ViewModel.Suggestions, Mode=OneWay}"
                                        TextChanged="GlobalSearchBox_TextChanged"
                                        QuerySubmitted="GlobalSearchBox_QuerySubmitted">
                            <AutoSuggestBox.ItemTemplate>
                                <DataTemplate x:DataType="models:SearchSuggestion">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="{x:Bind local:MainWindow.GetSuggestionGlyph(Type)}" 
                                                  FontFamily="Segoe MDL2 Assets" 
                                                  FontSize="16" 
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </AutoSuggestBox.ItemTemplate>
                        </AutoSuggestBox>
                    </NavigationView.Header>
                    <NavigationView.MenuItems>
                        <NavigationViewItem Content="Home" Icon="Home" Tag="Home" x:Name="HomeItem" />
                        <NavigationViewItem Content="Library" Tag="Library" x:Name="LibraryItem">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE8F1;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Albums" Tag="Albums">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE93C;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Artists" Icon="Contact" Tag="Artists" />
                        <NavigationViewItem Content="Playlists" Tag="Playlists">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE90B;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Now Playing" Tag="NowPlaying" x:Name="NowPlayingItem">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="{x:Bind GetNowPlayingGlyph(ViewModel.IsPlaying), Mode=OneWay}" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Audio FX" Tag="AudioFX" x:Name="AudioFxItem">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE9D9;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationView.MenuItems>
                    
                    <Frame x:Name="ContentFrame" />
                </NavigationView>
            </SplitView.Content>
            
            <SplitView.Pane>
                <Grid Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" HorizontalAlignment="Right" Margin="16,16,16,0" Command="{x:Bind ViewModel.ToggleNowPlayingCommand}"
                            Background="Transparent" BorderBrush="Transparent" Padding="6" ToolTipService.ToolTip="Close">
                        <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Button>

                    <Pivot Grid.Row="1" x:Name="SidebarPivot">
                        <PivotItem Header="Info" Margin="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Padding="20,0,20,20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Width="280" Height="280" HorizontalAlignment="Center" Margin="0,16,0,24">
                                        <Border CornerRadius="8" Background="{ThemeResource SystemControlHighlightAccentBrush}" Opacity="0.15">
                                            <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="72" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" />
                                        </Border>
                                        <Border CornerRadius="8">
                                            <Image Source="{Binding ViewModel.CurrentArtworkUrl, Converter={StaticResource ArtworkPathConverter}}" Stretch="UniformToFill" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Spacing="16">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.TrackTitle, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ViewModel.ArtistName, Mode=OneWay}" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ViewModel.AlbumName, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="File Properties" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Grid ColumnSpacing="12" RowSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Bitrate" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.InfoBitrate, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Sample Rate" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.InfoSampleRate, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="File Size" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.InfoFileSize, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Format" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.InfoFormat, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                
                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Location" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.InfoLocation, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </PivotItem>

                        <PivotItem Header="Up Next" Margin="0">
                            <Grid Padding="12,0,12,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Content="Clear" HorizontalAlignment="Right" Margin="0,0,8,8" Padding="8,4" Command="{x:Bind ViewModel.ClearQueueCommand}" Style="{StaticResource GhostIconButtonStyle}" />
                                <ListView Grid.Row="1" x:Name="SidebarQueueList" ItemsSource="{x:Bind ViewModel.QueueItems, Mode=OneWay}" CanReorderItems="True" AllowDrop="True" CanDragItems="True" SelectionMode="None" IsItemClickEnabled="True" ItemClick="QueueList_ItemClick">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:QueueItem">
                                            <Grid ColumnSpacing="8" Padding="0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Track.Title}" TextTrimming="CharacterEllipsis" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind Track.ArtistName}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Click="QueueRemove_Click" Style="{StaticResource GhostIconButtonStyle}" ToolTipService.ToolTip="Remove from queue">
                                                    <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </PivotItem>
                    </Pivot>
                </Grid>
            </SplitView.Pane>
        </SplitView>

        <!-- Bottom Playback Dashboard Bar -->
        <!-- NF-14: was {StaticResource PageBackgroundBrush} (#121212, dark-locked) -->
        <Grid Grid.Row="2" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Padding="16,12,16,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*" MaxWidth="350" x:Name="TrackDetailsColumn" />
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="2.5*" MaxWidth="300" x:Name="UtilitiesColumn" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Track Details & Favorite -->
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderBrush="Transparent" Padding="4" Click="TrackDetails_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="16">
                        <Grid Width="56" Height="56">
                            <Border CornerRadius="4" Background="{ThemeResource SystemControlHighlightAccentBrush}" Opacity="0.15">
                                <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" />
                            </Border>
                            <Border CornerRadius="4">
                                <Image Source="{Binding ViewModel.CurrentArtworkUrl, Converter={StaticResource ArtworkPathConverter}, ConverterParameter=Small}" Stretch="UniformToFill" UseLayoutRounding="True"/>
                            </Border>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.TrackTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                            <TextBlock Text="{x:Bind ViewModel.ArtistName, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                            <Border Margin="0,4,0,0" HorizontalAlignment="Left" CornerRadius="4" Padding="6,2" Background="{ThemeResource LayerFillColorDefaultBrush}" ToolTipService.Placement="Top">
                                <ToolTipService.ToolTip>
                                    <!-- Hotfix: was {ThemeResource
                                         SolidBackgroundFillColorDefaultBrush},
                                         which is NOT a WinUI theme-dictionary
                                         key and crashed at window load; the
                                         tertiary solid fill is the existing
                                         equivalent of the old #18181A surface. -->
                                    <ToolTip Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14" MaxWidth="450">
                                        <StackPanel Spacing="8">
                                            <!-- Header -->
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE93E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#00E676" />
                                                <TextBlock Text="AUDIO PIPELINE &amp; STREAM QUALITY" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" CharacterSpacing="50" />
                                            </StackPanel>

                                            <MenuFlyoutSeparator Margin="0,0,0,2" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                            <Grid ColumnSpacing="12" RowSpacing="5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Stream Format -->
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Stream (Source):" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind ViewModel.AudioQualityInfo.StreamQuality, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="#00E676" />
                                                    <TextBlock Text="{x:Bind ViewModel.AudioQualityInfo.ChannelsText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Codec / Container -->
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Codec / Format:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.AudioQualityInfo.CodecFormat, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                                <!-- Decoder Engine -->
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Decoder Engine:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.AudioQualityInfo.DecoderEngine, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                                <MenuFlyoutSeparator Grid.Row="3" Grid.ColumnSpan="2" Margin="0,2" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                                <!-- Output Device Format -->
                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Hardware Output:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.AudioQualityInfo.OutputDeviceQuality, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />

                                                <!-- Resampling State -->
                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Resampling State:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.AudioQualityInfo.ResamplingStatus, Mode=OneWay}" FontSize="11" Foreground="#FFD54F" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                                <!-- Output Device Name -->
                                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Active Output:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.AudioQualityInfo.OutputDeviceName, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="170" VerticalAlignment="Center" />
                                            </Grid>

                                            <MenuFlyoutSeparator Margin="0,2,0,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                            
                                            <!-- DSP / EQ Processing -->
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind ViewModel.AudioQualityInfo.DspStatus, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE93E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#00E676" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.StreamingQuality, Mode=OneWay}" FontSize="10" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Button>
                
                <!-- Favorite Button -->
                <Button Grid.Column="1" Command="{x:Bind ViewModel.ToggleCurrentTrackFavoriteCommand}" Style="{StaticResource GhostIconButtonStyle}" VerticalAlignment="Center" Margin="0,0,16,0" ToolTipService.ToolTip="Favorite">
                    <FontIcon Glyph="{x:Bind GetFavoriteGlyph(ViewModel.IsCurrentTrackFavorite), Mode=OneWay}" FontFamily="Segoe MDL2 Assets" Foreground="{x:Bind GetFavoriteColor(ViewModel.IsCurrentTrackFavorite), Mode=OneWay}" FontSize="16" />
                </Button>
            </Grid>

            <!-- Column 1: Playback Controls and Seek Bar -->
            <Grid Grid.Column="1" x:Name="CenterPlaybackColumn" VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="600">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <!-- Transport Controls -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <!-- Shuffle -->
                    <Button Command="{x:Bind ViewModel.ToggleShuffleCommand}" Style="{StaticResource GhostIconButtonStyle}">
                        <FontIcon Glyph="&#xE8B1;" FontFamily="Segoe MDL2 Assets" Foreground="{x:Bind GetShuffleColor(ViewModel.IsShuffle), Mode=OneWay}" FontSize="16" />
                    </Button>
                    
                    <!-- Previous -->
                    <Button Command="{x:Bind ViewModel.PreviousCommand}" Style="{StaticResource GhostIconButtonStyle}">
                        <FontIcon Glyph="&#xE892;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="18" />
                    </Button>
                    
                    <!-- Play / Pause (Circular) -->
                    <Grid Width="40" Height="40">
                        <Button Command="{x:Bind ViewModel.PlayCommand}" Visibility="{x:Bind BoolToVisibilityNegation(ViewModel.IsPlaying), Mode=OneWay}" Style="{StaticResource SmallPlayButtonStyle}">
                            <FontIcon Glyph="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                        </Button>
                        <Button Command="{x:Bind ViewModel.PauseCommand}" Visibility="{x:Bind BoolToVisibility(ViewModel.IsPlaying), Mode=OneWay}" Style="{StaticResource SmallPlayButtonStyle}">
                            <FontIcon Glyph="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                        </Button>
                    </Grid>

                    <!-- Next -->
                    <Button Command="{x:Bind ViewModel.NextCommand}" Style="{StaticResource GhostIconButtonStyle}">
                        <FontIcon Glyph="&#xE893;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="18" />
                    </Button>

                    <!-- Repeat -->
                    <Button Command="{x:Bind ViewModel.CycleRepeatCommand}" Style="{StaticResource GhostIconButtonStyle}">
                        <FontIcon Glyph="{x:Bind GetRepeatGlyph(ViewModel.RepeatMode), Mode=OneWay}" FontFamily="Segoe MDL2 Assets" Foreground="{x:Bind GetRepeatColor(ViewModel.RepeatMode), Mode=OneWay}" FontSize="16" />
                    </Button>
                </StackPanel>

                <!-- Timeline Slider -->
                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind FormatSeconds(ViewModel.PositionSeconds), Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Width="40" TextAlignment="Right" Margin="0,0,8,0"/>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <controls:SpectrumVisualizerControl x:Name="ProgressBarVisualizer" Visibility="{x:Bind BoolToVisibility(ViewModel.IsVisualizerEnabled), Mode=OneWay}" Margin="8,0,8,8" VerticalAlignment="Center" Height="25" />
                        <Slider x:Name="PlaybackSlider" Minimum="0" Maximum="{x:Bind ViewModel.DurationSeconds, Mode=OneWay}" Value="{x:Bind ViewModel.PositionSeconds, Mode=OneWay}" IsThumbToolTipEnabled="False" VerticalAlignment="Center" Margin="0,-8,0,-8" ValueChanged="PlaybackSlider_ValueChanged" PointerPressed="PlaybackSlider_PointerPressed" PointerReleased="PlaybackSlider_PointerReleased" PointerCaptureLost="PlaybackSlider_PointerCaptureLost" PointerCanceled="PlaybackSlider_PointerCanceled" ManipulationStarted="PlaybackSlider_ManipulationStarted" ManipulationCompleted="PlaybackSlider_ManipulationCompleted"/>
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{x:Bind FormatSeconds(ViewModel.DurationSeconds), Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Width="40" TextAlignment="Left" Margin="8,0,0,0"/>
                </Grid>
            </Grid>

            <!-- Column 2: Utilities (Now Playing, Queue, Mute, Volume) -->
            <StackPanel Grid.Column="2" x:Name="ExtraControlsPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                <!-- Queue Toggle Button -->
                <Button Click="QueueButton_Click" Style="{StaticResource GhostIconButtonStyle}" ToolTipService.ToolTip="Queue">
                    <FontIcon Glyph="&#xE8FD;" FontFamily="Segoe MDL2 Assets" Foreground="{x:Bind GetActiveColor(ViewModel.IsNowPlayingOpen), Mode=OneWay}" FontSize="16" />
                </Button>

                <!-- Mini Player -->
                <Button Click="MiniPlayer_Click" Style="{StaticResource GhostIconButtonStyle}" ToolTipService.ToolTip="Mini player">
                    <FontIcon Glyph="&#xE944;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="16" />
                </Button>

                <!-- Mute -->
                <Button Command="{x:Bind ViewModel.ToggleMuteCommand}" Style="{StaticResource GhostIconButtonStyle}">
                    <FontIcon Glyph="{x:Bind GetMuteGlyph(ViewModel.IsMuted, ViewModel.Volume), Mode=OneWay}" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="16" />
                </Button>

                <!-- Volume Slider -->
                <Slider Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" Width="100" VerticalAlignment="Center" Margin="0,0,16,0" PointerWheelChanged="VolumeSlider_PointerWheelChanged"/>
            </StackPanel>

            <!-- Overflow menu for narrow windows -->
            <Button Grid.Column="2" x:Name="MoreOptionsButton" Visibility="Collapsed" HorizontalAlignment="Right" Style="{StaticResource GhostIconButtonStyle}">
                <Button.Flyout>
                    <Flyout Placement="TopEdgeAlignedRight">
                        <StackPanel Spacing="16" Width="200" Padding="12">
                            <Button Click="QueueButton_Click" Style="{StaticResource GhostIconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE8FD;" FontFamily="Segoe MDL2 Assets" Foreground="{x:Bind GetActiveColor(ViewModel.IsNowPlayingOpen), Mode=OneWay}" FontSize="16" />
                                    <TextBlock Text="Queue" />
                                </StackPanel>
                            </Button>
                            <Button Click="MiniPlayer_Click" Style="{StaticResource GhostIconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE944;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="16" />
                                    <TextBlock Text="Mini Player" />
                                </StackPanel>
                            </Button>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{x:Bind ViewModel.ToggleMuteCommand}" Style="{StaticResource GhostIconButtonStyle}">
                                    <FontIcon Glyph="{x:Bind GetMuteGlyph(ViewModel.IsMuted, ViewModel.Volume), Mode=OneWay}" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="16" />
                                </Button>
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0,0,0" PointerWheelChanged="VolumeSlider_PointerWheelChanged"/>
                            </Grid>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                <FontIcon Glyph="&#xE712;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="16" />
            </Button>
        </Grid>
    </Grid>
</Window>
