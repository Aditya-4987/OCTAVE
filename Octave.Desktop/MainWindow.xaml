<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Octave_Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Octave_Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Octave.Desktop"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Octave.Desktop">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
            <TextBlock Text="OCTAVE: STATIC FIRE HARNESS" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Bind ViewModel.TrackTitle, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Bind ViewModel.ArtistName, Mode=OneWay}" FontSize="16" Foreground="#888888" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <Button Content="Ignite Main Engines" Command="{x:Bind ViewModel.RunStaticFireCommand}" Width="250" Height="40" HorizontalAlignment="Center"/>
            <ScrollViewer MaxHeight="250" Margin="0,20,0,0" Background="#111111" Padding="10">
                <TextBlock x:Name="ConsoleLog" Text="{x:Bind ViewModel.ConsoleOutput, Mode=OneWay}" TextWrapping="Wrap" FontFamily="Consolas" Foreground="#00FF66"/>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Window>
