<Page
    x:Class="Octave_Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Octave.Core.Models"
    xmlns:local="using:Octave_Desktop.Views"
    xmlns:vm="using:Octave_Desktop.ViewModels"
    xmlns:converters="using:Octave_Desktop.Converters"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <!-- Semantic status colors: light-theme-readable variants of the old
                 hardcoded neon values (#EF5350 family was unreadable on white). -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="OCTAVE_StatusSuccess" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="OCTAVE_StatusDanger" Color="#FF99A4" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="OCTAVE_StatusSuccess" Color="#0F7B3D" />
                    <SolidColorBrush x:Key="OCTAVE_StatusDanger" Color="#C42B1C" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <converters:DbFormatConverter x:Key="DbFormatConverter" />

            <!-- Windows 11 settings-card language: one shared card chrome, rows of
                 title/description on the left and the control on the right. -->
            <Style TargetType="Border" x:Key="SettingsCard">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style TargetType="TextBlock" x:Key="CardTitleStyle">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style TargetType="TextBlock" x:Key="RowTitleStyle">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style TargetType="TextBlock" x:Key="RowDescStyle">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style TargetType="TextBlock" x:Key="CapsHeaderStyle">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{ThemeResource SystemControlHighlightAccentBrush}" />
                <Setter Property="CharacterSpacing" Value="80" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="28,16,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,8,0,20">
            <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Playback behavior, audio engine tools, library maintenance, and online data policies."
                       FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel Spacing="12" MaxWidth="980" HorizontalAlignment="Stretch" Padding="0,0,4,40">

                <!-- ================================================== -->
                <!-- PLAYBACK                                          -->
                <!-- ================================================== -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Playback" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,6" />

                        <!-- Sleep timer -->
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Sleep timer" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="Automatically pause playback after the chosen interval."
                                           Style="{StaticResource RowDescStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.SleepTimerStatus, Mode=OneWay}"
                                           FontSize="12" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                           Visibility="{x:Bind StatusVisibleWhenActive(ViewModel.SleepTimerStatus), Mode=OneWay}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" MinWidth="130" SelectedIndex="0"
                                      VerticalAlignment="Center" Margin="12,0,0,0"
                                      SelectionChanged="SleepTimerCombo_SelectionChanged">
                                <ComboBoxItem Content="Off" />
                                <ComboBoxItem Content="15 minutes" />
                                <ComboBoxItem Content="30 minutes" />
                                <ComboBoxItem Content="45 minutes" />
                                <ComboBoxItem Content="60 minutes" />
                            </ComboBox>
                        </Grid>
                        <MenuFlyoutSeparator />

                        <!-- Session resume -->
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Remember playback position" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="Choose whether OCTAVE remembers the exact timestamp where a track was paused on startup."
                                           Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          IsOn="{x:Bind ViewModel.RestorePositionOnStartup, Mode=TwoWay}"
                                          OffContent="Off" OnContent="On" />
                        </Grid>
                        <MenuFlyoutSeparator />

                        <!-- Visualizer -->
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Progress bar visualizer" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="Show a real-time waveform above the progress bar during playback."
                                           Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          IsOn="{x:Bind ViewModel.IsVisualizerEnabled, Mode=TwoWay}"
                                          OffContent="Off" OnContent="On" />
                        </Grid>
                        <MenuFlyoutSeparator />

                        <!-- Crossfade -->
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Crossfade" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="Smoothly fade track volume when skipping or switching songs."
                                           Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          IsOn="{x:Bind ViewModel.IsCrossfadeEnabled, Mode=TwoWay}"
                                          OffContent="Off" OnContent="On" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4,0,8"
                                    Visibility="{x:Bind BoolToVisibility(ViewModel.IsCrossfadeEnabled), Mode=OneWay}">
                            <TextBlock Text="Crossfade duration:" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" />
                            <Slider Width="220" Minimum="1" Maximum="10" StepFrequency="1"
                                    Value="{x:Bind ViewModel.CrossfadeSeconds, Mode=TwoWay}" VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="13">
                                <Run Text="{x:Bind ViewModel.CrossfadeSeconds, Mode=OneWay}" /><Run Text=" sec" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================================================== -->
                <!-- EQUALIZER                                         -->
                <!-- ================================================== -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Spacing="4">
                        <!-- UI-ST-04: the EQ silently did nothing without bass_fx.dll -
                             the pill states up front whether the DSP engine loaded. -->
                        <Grid ColumnDefinitions="*,Auto" Padding="0,8,0,6">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Equalizer" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="10-band graphic equalizer applied before the output limiter."
                                           Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <!-- NF-23: plain colored status text instead of pill chips. -->
                                <TextBlock Text="Ready"
                                           FontSize="12" FontWeight="SemiBold" CharacterSpacing="40"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource OCTAVE_StatusSuccess}"
                                           Visibility="{x:Bind BoolToVisibility(ViewModel.IsEqEngineAvailable), Mode=OneWay}"
                                           ToolTipService.ToolTip="bass_fx.dll loaded - the equalizer is available"/>
                                <TextBlock Text="Error"
                                           FontSize="12" FontWeight="SemiBold" CharacterSpacing="40"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource OCTAVE_StatusDanger}"
                                           Visibility="{x:Bind BoolToVisibilityInverted(ViewModel.IsEqEngineAvailable), Mode=OneWay}"
                                           ToolTipService.ToolTip="bass_fx.dll failed to load - the equalizer is unavailable"/>
                                <ToggleSwitch Header="Enable" IsOn="{x:Bind ViewModel.EqEnabled, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.EqBands, Mode=OneWay}" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EqBandViewModel">
                                    <StackPanel Width="50" HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Bind Gain, Mode=OneWay, Converter={StaticResource DbFormatConverter}}"
                                                   FontSize="12" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                                   HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <Slider Orientation="Vertical" Height="200" Minimum="-15" Maximum="15" StepFrequency="0.5"
                                                Value="{x:Bind Gain, Mode=TwoWay}" HorizontalAlignment="Center"
                                                IsThumbToolTipEnabled="False" />
                                        <TextBlock Text="{x:Bind Label}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,10,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- UI-ST-03: presets show which one is active (check glyph +
                             caption); hand-tuning any band flips the caption to Custom. -->
                        <StackPanel Spacing="8" Margin="0,8,0,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Presets â€” active:" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.ActivePresetName, Mode=OneWay}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{ThemeResource SystemControlHighlightAccentBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{x:Bind ViewModel.EqPresetCommand}" CommandParameter="Flat">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE73E;" FontSize="12" FontFamily="Segoe MDL2 Assets"
                                                  Visibility="{x:Bind PresetCheckVisible('Flat', ViewModel.ActivePresetName), Mode=OneWay}" />
                                        <TextBlock Text="Flat" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.EqPresetCommand}" CommandParameter="BassBoost">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE73E;" FontSize="12" FontFamily="Segoe MDL2 Assets"
                                                  Visibility="{x:Bind PresetCheckVisible('BassBoost', ViewModel.ActivePresetName), Mode=OneWay}" />
                                        <TextBlock Text="Bass Boost" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.EqPresetCommand}" CommandParameter="TrebleBoost">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE73E;" FontSize="12" FontFamily="Segoe MDL2 Assets"
                                                  Visibility="{x:Bind PresetCheckVisible('TrebleBoost', ViewModel.ActivePresetName), Mode=OneWay}" />
                                        <TextBlock Text="Treble Boost" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.EqPresetCommand}" CommandParameter="Vocal">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE73E;" FontSize="12" FontFamily="Segoe MDL2 Assets"
                                                  Visibility="{x:Bind PresetCheckVisible('Vocal', ViewModel.ActivePresetName), Mode=OneWay}" />
                                        <TextBlock Text="Vocal" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.EqPresetCommand}" CommandParameter="Electronic">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE73E;" FontSize="12" FontFamily="Segoe MDL2 Assets"
                                                  Visibility="{x:Bind PresetCheckVisible('Electronic', ViewModel.ActivePresetName), Mode=OneWay}" />
                                        <TextBlock Text="Electronic" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.EqPresetCommand}" CommandParameter="Acoustic">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE73E;" FontSize="12" FontFamily="Segoe MDL2 Assets"
                                                  Visibility="{x:Bind PresetCheckVisible('Acoustic', ViewModel.ActivePresetName), Mode=OneWay}" />
                                        <TextBlock Text="Acoustic" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================================================== -->
                <!-- MUSIC LIBRARY                                     -->
                <!-- ================================================== -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Music Library" Style="{StaticResource CardTitleStyle}" Margin="0,8,0,6" />

                        <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Monitored folders" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="Folders OCTAVE scans and watches for music."
                                           Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Add Folder" Click="AddFolder_Click"
                                        IsEnabled="{x:Bind ViewModel.IsNotProcessing, Mode=OneWay}"
                                        ToolTipService.ToolTip="Pick a folder to scan and watch for music. Scanning runs in the background and can be continued later." />
                                <Button Content="Rescan All" Command="{x:Bind ViewModel.RescanAllCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsNotProcessing, Mode=OneWay}"
                                        ToolTipService.ToolTip="Re-read every monitored folder to pick up new, changed, or removed files." />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4"
                                    Visibility="{x:Bind BoolToVisibility(ViewModel.IsProcessing), Mode=OneWay}">
                            <ProgressRing IsActive="True" Width="16" Height="16" />
                            <TextBlock Text="Processing folders..." Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.MonitoredFolders, Mode=OneWay}" Margin="0,0,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid Padding="0,4" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" />
                                        <Button Grid.Column="1" Content="Remove" Click="RemoveFolder_Click"
                                                Background="Transparent"
                                                ToolTipService.ToolTip="Stop watching this folder. Tracks already imported stay in your library." />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <MenuFlyoutSeparator />

                        <!-- Duplicate tracks -->
                        <StackPanel Spacing="6" Padding="0,10,0,0">
                            <TextBlock Text="Duplicate Tracks" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="Find the same song stored in multiple formats (e.g. MP3 and FLAC)."
                                       Style="{StaticResource RowDescStyle}" />
                            <!-- UI-ST-01/SH-05: spell out what deletion does before anyone
                                 reaches for the red button - both delete paths confirm first,
                                 and bulk deletion always keeps the primary copy. -->
                            <TextBlock Text="Deletions send files to the Recycle Bin and keep the highest-quality copy in each group. Use â€œManageâ€ on a group to review or move individual copies."
                                       Style="{StaticResource RowDescStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
                                <Button Content="Scan for Duplicates" Command="{x:Bind ViewModel.FindDuplicatesCommand}" />
                                <Button Content="Delete All Duplicates" Click="DeleteAllDuplicates_Click"
                                        Foreground="{ThemeResource OCTAVE_StatusDanger}"
                                        ToolTipService.ToolTip="Move every non-primary copy in ALL found groups to the Recycle Bin. A confirmation shows counts first." />
                                <TextBlock Text="{x:Bind ViewModel.DuplicatesSummary, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.Duplicates, Mode=OneWay}" Margin="0,4,0,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DuplicateGroup">
                                        <Grid Padding="0,6" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{x:Bind Title}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind ArtistName}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind local:SettingsPage.DuplicateSummary(Tracks)}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Content="Manage" Margin="16,0,0,0"
                                                    ToolTipService.ToolTip="Review each copy in this group individually.">
                                                <Button.Flyout>
                                                    <Flyout>
                                                        <ListView ItemsSource="{x:Bind Tracks}">
                                                            <ListView.ItemTemplate>
                                                                <DataTemplate x:DataType="models:Track">
                                                                    <Grid Padding="4" ColumnSpacing="8" Width="400">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{x:Bind SourceUri}" FontSize="11"
                                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                            <Button Content="Move" Click="MoveDuplicate_Click"
                                                                                    ToolTipService.ToolTip="Moves the physical audio file to another folder and updates its path in the library database." />
                                                                            <Button Content="Delete" Click="DeleteDuplicate_Click"
                                                                                    ToolTipService.ToolTip="Sends this copy to the Recycle Bin and removes it from the library." />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListView.ItemTemplate>
                                                        </ListView>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================================================== -->
                <!-- ONLINE & EXTERNAL DATA                            -->
                <!-- ================================================== -->
                <StackPanel Spacing="4" Margin="0,16,0,0">
                    <TextBlock Text="Online &amp; External Data" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Configure external providers, community metadata, online artwork, synchronized lyrics, and write safety policies."
                               FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Smart Library Enrichment launcher -->
                <Border Style="{StaticResource SettingsCard}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Smart Library Enrichment" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Scan your local library to preview or automatically enrich missing metadata, album artwork, lyrics, and artist biographies."
                                       Style="{StaticResource RowDescStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Center"
                                Content="Scan &amp; Enrich Library..."
                                Click="OpenLibraryEnrichment_Click"
                                Style="{StaticResource AccentButtonStyle}" FontWeight="SemiBold" Height="36" />
                    </Grid>
                </Border>

                <!-- Privacy & Offline -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="PRIVACY &amp; OFFLINE MODE" Style="{StaticResource CapsHeaderStyle}" />
                        <TextBlock Text="OCTAVE connects to online community databases (MusicBrainz, Cover Art Archive, LRCLIB, and TheAudioDB) to retrieve metadata, high-resolution artwork, biographies, and synchronized lyrics. Song title, artist, and album names are transmitted during search queries."
                                   Style="{StaticResource RowDescStyle}" />

                        <ToggleSwitch Header="Offline-Only Mode (Disable All Remote API Requests)"
                                      IsOn="{x:Bind ExternalSettings.OfflineOnlyMode, Mode=TwoWay}"
                                      Toggled="SettingToggled"
                                      OffContent="Online enrichment active (Uses internet &amp; cache)"
                                      OnContent="Offline only (Uses local database &amp; existing cache only)" />

                        <StackPanel Spacing="6" Visibility="{x:Bind BoolToVisibilityInverted(ExternalSettings.OfflineOnlyMode), Mode=OneWay}">
                            <ToggleSwitch Header="Enable Online Metadata Lookup (MusicBrainz)"
                                          IsOn="{x:Bind ExternalSettings.EnableOnlineMetadata, Mode=TwoWay}"
                                          Toggled="SettingToggled" />
                            <ToggleSwitch Header="Enable Online Lyrics Retrieval (LRCLIB)"
                                          IsOn="{x:Bind ExternalSettings.EnableOnlineLyrics, Mode=TwoWay}"
                                          Toggled="SettingToggled" />
                            <ToggleSwitch Header="Enable Online Album Artwork Retrieval (Cover Art Archive)"
                                          IsOn="{x:Bind ExternalSettings.EnableOnlineArtwork, Mode=TwoWay}"
                                          Toggled="SettingToggled" />
                            <ToggleSwitch Header="Enable Artist Enrichment (TheAudioDB)"
                                          IsOn="{x:Bind ExternalSettings.EnableArtistEnrichment, Mode=TwoWay}"
                                          Toggled="SettingToggled" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Providers -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="EXTERNAL PROVIDERS" Style="{StaticResource CapsHeaderStyle}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="MusicBrainz" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Music identity, release dates, track numbering &amp; fuzzy matching. (Rate-limited to 1 req/s, no key required)" Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ExternalSettings.MusicBrainzEnabled, Mode=TwoWay}" Toggled="SettingToggled" VerticalAlignment="Center" />
                        </Grid>

                        <MenuFlyoutSeparator />

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="LRCLIB" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Synchronized timestamped (.lrc) and plain text lyrics. (No key required)" Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ExternalSettings.LrcLibEnabled, Mode=TwoWay}" Toggled="SettingToggled" VerticalAlignment="Center" />
                        </Grid>

                        <MenuFlyoutSeparator />

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Cover Art Archive" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Internet Archive community repository for front album artwork. (No key required)" Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ExternalSettings.CoverArtArchiveEnabled, Mode=TwoWay}" Toggled="SettingToggled" VerticalAlignment="Center" />
                        </Grid>

                        <MenuFlyoutSeparator />

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="TheAudioDB" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Artist biographies, genres, formation dates, social links, and profile photos." Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ExternalSettings.TheAudioDbEnabled, Mode=TwoWay}" Toggled="SettingToggled" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- API Credentials -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="API CREDENTIALS" Style="{StaticResource CapsHeaderStyle}" />
                        <TextBlock Text="Configure provider authentication keys. Keys are stored locally and never exposed in logs or diagnostics."
                                   Style="{StaticResource RowDescStyle}" />

                        <!-- UI-ST-06: the public test key is rate-limit throttled and the
                             page now says where to get a real key instead of assuming
                             everyone knows about theaudiodb.com's API registration. -->
                        <TextBlock Text="The default public test key â€œ2â€ is shared by everyone and strictly rate-limited â€” expect slower artist enrichment. You can request a free supporter key at theaudiodb.com (API Registration) and paste it below."
                                   Style="{StaticResource RowDescStyle}" TextWrapping="Wrap" />

                        <TextBlock Text="{x:Bind ExternalSettings.TheAudioDbStatusText, Mode=OneWay}"
                                   FontSize="12" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <PasswordBox Grid.Column="0"
                                         Header="TheAudioDB API Key"
                                         Password="{x:Bind ExternalSettings.TheAudioDbApiKey, Mode=TwoWay}"
                                         PasswordRevealMode="Peek"
                                         PasswordChanged="TheAudioDbPasswordBox_PasswordChanged"
                                         LostFocus="TheAudioDbPasswordBox_LostFocus"
                                         PlaceholderText="Enter TheAudioDB API Key"
                                         Margin="0,0,8,0" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Height="36"
                                    Content="Test Connection"
                                    Command="{x:Bind ExternalSettings.TestTheAudioDbConnectionCommand}"
                                    IsEnabled="{x:Bind BoolToInverted(ExternalSettings.IsTestingConnection), Mode=OneWay}" />
                        </Grid>

                        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind BoolToVisibility(ExternalSettings.IsTestingConnection), Mode=OneWay}" />
                        <InfoBar IsOpen="{x:Bind ExternalSettings.IsConnectionTestVisible, Mode=OneWay}"
                                 Message="{x:Bind ExternalSettings.ConnectionTestMessage, Mode=OneWay}"
                                 Severity="{x:Bind ExternalSettings.ConnectionTestSeverity, Mode=OneWay}"
                                 IsClosable="True" />
                    </StackPanel>
                </Border>

                <!-- Metadata Write Policy -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="METADATA WRITE &amp; AUTOMATION POLICY" Style="{StaticResource CapsHeaderStyle}" />
                        <TextBlock Text="Control when and how external metadata is written to local audio files." Style="{StaticResource RowDescStyle}" />

                        <ComboBox Header="Automatic Write Policy"
                                  SelectedIndex="{x:Bind ExternalSettings.WritePolicyIndex, Mode=TwoWay}"
                                  SelectionChanged="SettingSelectionChanged"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Never write automatically (Review changes before applying)" />
                            <ComboBoxItem Content="Write only when metadata is missing &amp; match is high confidence (Recommended)" />
                            <ComboBoxItem Content="Write only on high confidence matches" />
                            <ComboBoxItem Content="Always prefer online metadata" />
                        </ComboBox>

                        <ToggleSwitch Header="Write MusicBrainz IDs to file tags when available"
                                      IsOn="{x:Bind ExternalSettings.WriteExternalIdsToTags, Mode=TwoWay}"
                                      Toggled="SettingToggled" />
                        <ToggleSwitch Header="Automatically download missing album artwork"
                                      IsOn="{x:Bind ExternalSettings.AutoDownloadMissingArtwork, Mode=TwoWay}"
                                      Toggled="SettingToggled" />
                        <ToggleSwitch Header="Automatically download missing artist profile images"
                                      IsOn="{x:Bind ExternalSettings.AutoDownloadMissingArtistImages, Mode=TwoWay}"
                                      Toggled="SettingToggled" />
                        <ToggleSwitch Header="Auto-fill empty/missing metadata tags"
                                      IsOn="{x:Bind ExternalSettings.AutoFillMissingMetadata, Mode=TwoWay}"
                                      Toggled="SettingToggled" />
                        <ToggleSwitch Header="Replace existing metadata tags with online values"
                                      IsOn="{x:Bind ExternalSettings.ReplaceExistingMetadata, Mode=TwoWay}"
                                      Toggled="SettingToggled" />
                        <ToggleSwitch Header="Replace existing embedded artwork with online covers"
                                      IsOn="{x:Bind ExternalSettings.ReplaceExistingArtwork, Mode=TwoWay}"
                                      Toggled="SettingToggled" />
                    </StackPanel>
                </Border>

                <!-- Caching & Network -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="CACHING &amp; NETWORK RATE LIMITS" Style="{StaticResource CapsHeaderStyle}" />

                        <ToggleSwitch Header="Use cached metadata and artwork when offline"
                                      IsOn="{x:Bind ExternalSettings.UseCachedDataOffline, Mode=TwoWay}"
                                      Toggled="SettingToggled" />
                        <ToggleSwitch Header="Allow stale cached responses if provider is temporarily unavailable"
                                      IsOn="{x:Bind ExternalSettings.AllowStaleCacheOnProviderFailure, Mode=TwoWay}"
                                      Toggled="SettingToggled" />

                        <ComboBox Header="Cache Retention Duration"
                                  SelectedIndex="{x:Bind ExternalSettings.CacheRetentionDaysIndex, Mode=TwoWay}"
                                  SelectionChanged="SettingSelectionChanged"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="7 Days" />
                            <ComboBoxItem Content="30 Days (Default)" />
                            <ComboBoxItem Content="90 Days" />
                            <ComboBoxItem Content="180 Days" />
                            <ComboBoxItem Content="365 Days" />
                        </ComboBox>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Maximum concurrent external requests:" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="14" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Slider Width="180" Minimum="1" Maximum="10" StepFrequency="1" VerticalAlignment="Center"
                                        Value="{x:Bind ExternalSettings.MaxConcurrentRequests, Mode=TwoWay}"
                                        ValueChanged="SettingSliderChanged" />
                                <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="13" MinWidth="20">
                                    <Run Text="{x:Bind ExternalSettings.MaxConcurrentRequests, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Online Scan Preferences -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="ONLINE SCAN PREFERENCES" Style="{StaticResource CapsHeaderStyle}" />
                        <TextBlock Text="Configure targeted filters for automatic and manual library enrichment scan passes." Style="{StaticResource RowDescStyle}" />

                        <CheckBox Content="Scan entire library" IsChecked="{x:Bind ExternalSettings.ScanEntireLibrary, Mode=TwoWay}" Click="SettingCheckBoxClicked" />
                        <CheckBox Content="Scan only tracks with missing metadata" IsChecked="{x:Bind ExternalSettings.ScanOnlyMissingMetadata, Mode=TwoWay}" Click="SettingCheckBoxClicked" />
                        <CheckBox Content="Scan only tracks with missing artwork" IsChecked="{x:Bind ExternalSettings.ScanOnlyMissingArtwork, Mode=TwoWay}" Click="SettingCheckBoxClicked" />
                        <CheckBox Content="Scan only tracks with missing lyrics" IsChecked="{x:Bind ExternalSettings.ScanOnlyMissingLyrics, Mode=TwoWay}" Click="SettingCheckBoxClicked" />
                        <CheckBox Content="Recheck previously failed online matches" IsChecked="{x:Bind ExternalSettings.RecheckPreviouslyFailedMatches, Mode=TwoWay}" Click="SettingCheckBoxClicked" />
                        <CheckBox Content="Recheck ambiguous online matches" IsChecked="{x:Bind ExternalSettings.RecheckAmbiguousMatches, Mode=TwoWay}" Click="SettingCheckBoxClicked" />
                    </StackPanel>
                </Border>

                <!-- ================================================== -->
                <!-- ENGINE DIAGNOSTICS                                -->
                <!-- ================================================== -->
                <!-- UI-ST-02: normal-styled action inside the column, explained;
                     the console keeps its deliberate terminal look (#111111 /
                     green Consolas on purpose - see Â§18). -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Engine Diagnostic Harness" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Runs an internal BASS engine self-test and prints the report to the console below. No library files are modified."
                                   Style="{StaticResource RowDescStyle}" />
                        <Button Content="Run Engine Diagnostics (Static Fire)"
                                Command="{x:Bind ViewModel.RunStaticFireCommand}"
                                Width="300" Height="40" FontWeight="SemiBold" HorizontalAlignment="Left" />

                        <TextBlock Text="Console Log Output" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <ScrollViewer MaxHeight="300" Background="#111111" Padding="12" CornerRadius="6"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                            <TextBlock Text="{x:Bind ViewModel.ConsoleOutput, Mode=OneWay}"
                                       TextWrapping="Wrap" FontFamily="Consolas" Foreground="#00FF66"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
