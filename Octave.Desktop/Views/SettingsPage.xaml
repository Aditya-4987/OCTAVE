<Page
    x:Class="Octave_Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Octave.Core.Models"
    xmlns:local="using:Octave_Desktop.Views"
    xmlns:vm="using:Octave_Desktop.ViewModels"
    xmlns:converters="using:Octave_Desktop.Converters"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <converters:DbFormatConverter x:Key="DbFormatConverter" />
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Settings &amp; Diagnostics" FontSize="28" FontWeight="Bold" Margin="0,0,0,24" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Spacing="24" MaxWidth="600" HorizontalAlignment="Left" Padding="0,0,0,32">
            <!-- Sleep Timer -->
            <StackPanel Spacing="12">
                <TextBlock Text="Sleep Timer" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Off" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="0" />
                    <Button Content="15 min" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="15" />
                    <Button Content="30 min" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="30" />
                    <Button Content="45 min" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="45" />
                    <Button Content="60 min" Command="{x:Bind ViewModel.SetSleepTimerCommand}" CommandParameter="60" />
                    <TextBlock Text="{x:Bind ViewModel.SleepTimerStatus, Mode=OneWay}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- Playback & Session Resume -->
            <StackPanel Spacing="12">
                <TextBlock Text="Playback &amp; Session Resume" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Choose whether OCTAVE remembers the exact timestamp where a track was paused on startup."
                           FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <ToggleSwitch Header="Remember playback position on startup"
                              IsOn="{x:Bind ViewModel.RestorePositionOnStartup, Mode=TwoWay}"
                              OffContent="Disabled (Songs start from 0:00)"
                              OnContent="Enabled (Resumes exact saved timestamp)" />
            </StackPanel>

            <!-- Audio Visualizer -->
            <StackPanel Spacing="12">
                <TextBlock Text="Audio Visualizer" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Show real-time dynamic sound waveform visualizer above the progress bar during playback."
                           FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <ToggleSwitch Header="Enable progress bar audio visualizer"
                              IsOn="{x:Bind ViewModel.IsVisualizerEnabled, Mode=TwoWay}"
                              OffContent="Disabled (Hidden)"
                              OnContent="Enabled (Real-time dynamic waveform)" />
            </StackPanel>

            <!-- Audio Transition (Crossfade) -->
            <StackPanel Spacing="12">
                <TextBlock Text="Audio Transition (Crossfade)" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Smoothly fade track volume when skipping or switching songs."
                           FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <ToggleSwitch Header="Enable Crossfade" IsOn="{x:Bind ViewModel.IsCrossfadeEnabled, Mode=TwoWay}" />
                <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind BoolToVisibility(ViewModel.IsCrossfadeEnabled), Mode=OneWay}">
                    <TextBlock Text="Crossfade Duration:" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="14" />
                    <Slider Width="200" Minimum="1" Maximum="10" StepFrequency="1"
                            Value="{x:Bind ViewModel.CrossfadeSeconds, Mode=TwoWay}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.CrossfadeSeconds, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="14" />
                    <TextBlock Text="sec" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="14" Margin="-8,0,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Equalizer -->
            <StackPanel Spacing="12">
                <TextBlock Text="Equalizer" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="10-band graphic EQ. Requires bass_fx.dll (drop it in BassPlugins\)."
                           FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <ToggleSwitch Header="Enable equalizer" IsOn="{x:Bind ViewModel.EqEnabled, Mode=TwoWay}" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.EqBands, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EqBandViewModel">
                            <StackPanel Width="50" HorizontalAlignment="Center">
                                <TextBlock Text="{x:Bind Gain, Mode=OneWay, Converter={StaticResource DbFormatConverter}}" 
                                           FontSize="12" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" 
                                           HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <Slider Orientation="Vertical" Height="220" Minimum="-15" Maximum="15" StepFrequency="0.5"
                                        Value="{x:Bind Gain, Mode=TwoWay}" HorizontalAlignment="Center"
                                        IsThumbToolTipEnabled="False" />
                                <TextBlock Text="{x:Bind Label}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,10,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Flat" Command="{x:Bind ViewModel.EqPresetCommand}" CommandParameter="Flat" />
                    <Button Content="Bass Boost" Command="{x:Bind ViewModel.EqPresetCommand}" CommandParameter="BassBoost" />
                    <Button Content="Treble Boost" Command="{x:Bind ViewModel.EqPresetCommand}" CommandParameter="TrebleBoost" />
                    <Button Content="Vocal" Command="{x:Bind ViewModel.EqPresetCommand}" CommandParameter="Vocal" />
                    <Button Content="Electronic" Command="{x:Bind ViewModel.EqPresetCommand}" CommandParameter="Electronic" />
                    <Button Content="Acoustic" Command="{x:Bind ViewModel.EqPresetCommand}" CommandParameter="Acoustic" />
                </StackPanel>
            </StackPanel>

            <!-- Music Folders -->
            <StackPanel Spacing="12">
                <TextBlock Text="Music Folders" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Folders Octave scans and watches for music."
                           FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Add Folder" Click="AddFolder_Click" IsEnabled="{x:Bind ViewModel.IsNotProcessing, Mode=OneWay}" />
                    <Button Content="Rescan All" Command="{x:Bind ViewModel.RescanAllCommand}" IsEnabled="{x:Bind ViewModel.IsNotProcessing, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind BoolToVisibility(ViewModel.IsProcessing), Mode=OneWay}" VerticalAlignment="Center" Margin="16,0,0,0">
                        <ProgressRing IsActive="True" Width="16" Height="16" />
                        <TextBlock Text="Processing folders..." Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <ItemsControl ItemsSource="{x:Bind ViewModel.MonitoredFolders, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid Padding="0,4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" />
                                <Button Grid.Column="1" Content="Remove" Click="RemoveFolder_Click"
                                        Background="Transparent" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Duplicate Tracks -->
            <StackPanel Spacing="12">
                <TextBlock Text="Duplicate Tracks" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Find the same song stored in multiple formats (e.g. MP3 and FLAC)."
                           FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <!-- UI-ST-01/SH-05: spell out what deletion does before anyone
                     reaches for the red button - both delete paths confirm first,
                     and bulk deletion always keeps the primary copy. -->
                <TextBlock Text="Deletions send files to the Recycle Bin and keep the highest-quality copy in each group. Use “Manage” on a group to review or move individual copies."
                           FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Scan for Duplicates" Command="{x:Bind ViewModel.FindDuplicatesCommand}" />
                    <Button Content="Delete All Duplicates" Click="DeleteAllDuplicates_Click" Foreground="#EF5350" />
                    <TextBlock Text="{x:Bind ViewModel.DuplicatesSummary, Mode=OneWay}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Duplicates, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DuplicateGroup">
                            <Grid Padding="0,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Bind Title}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ArtistName}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind local:SettingsPage.DuplicateSummary(Tracks)}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="Manage" Margin="16,0,0,0">
                                    <Button.Flyout>
                                        <Flyout>
                                            <ListView ItemsSource="{x:Bind Tracks}">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:Track">
                                                        <Grid Padding="4" ColumnSpacing="8" Width="400">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{x:Bind SourceUri}" FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <Button Content="Move" Click="MoveDuplicate_Click" />
                                                                <Button Content="Delete" Click="DeleteDuplicate_Click" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ============================================================= -->
            <!-- ONLINE & EXTERNAL DATA SETTINGS -->
            <!-- ============================================================= -->
            <StackPanel Spacing="16">
                <TextBlock Text="Online &amp; External Data" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Configure external providers, community metadata, online artwork, synchronized lyrics, and write safety policies."
                           FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />

                <!-- 0. Smart Library Enrichment Launcher -->
                <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Smart Library Enrichment" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Scan your local library to preview or automatically enrich missing metadata, album artwork, lyrics, and artist biographies."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                Content="Scan &amp; Enrich Library..."
                                Click="OpenLibraryEnrichment_Click"
                                Background="{ThemeResource SystemControlHighlightAccentBrush}"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Height="36" />
                    </Grid>
                </Border>

                <!-- 1. Privacy & Offline Behavior -->
                <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="PRIVACY &amp; OFFLINE MODE" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" CharacterSpacing="80" />
                        <TextBlock Text="OCTAVE connects to online community databases (MusicBrainz, Cover Art Archive, LRCLIB, and TheAudioDB) to retrieve metadata, high-resolution artwork, biographies, and synchronized lyrics. Song title, artist, and album names are transmitted during search queries."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                        
                        <ToggleSwitch Header="Offline-Only Mode (Disable All Remote API Requests)"
                                      IsOn="{x:Bind ExternalSettings.OfflineOnlyMode, Mode=TwoWay}"
                                      Toggled="SettingToggled"
                                      OffContent="Online enrichment active (Uses internet &amp; cache)"
                                      OnContent="Offline only (Uses local database &amp; existing cache only)" />

                        <StackPanel Spacing="8" Visibility="{x:Bind BoolToVisibilityInverted(ExternalSettings.OfflineOnlyMode), Mode=OneWay}">
                            <ToggleSwitch Header="Enable Online Metadata Lookup (MusicBrainz)"
                                          IsOn="{x:Bind ExternalSettings.EnableOnlineMetadata, Mode=TwoWay}"
                                          Toggled="SettingToggled" />
                            <ToggleSwitch Header="Enable Online Lyrics Retrieval (LRCLIB)"
                                          IsOn="{x:Bind ExternalSettings.EnableOnlineLyrics, Mode=TwoWay}"
                                          Toggled="SettingToggled" />
                            <ToggleSwitch Header="Enable Online Album Artwork Retrieval (Cover Art Archive)"
                                          IsOn="{x:Bind ExternalSettings.EnableOnlineArtwork, Mode=TwoWay}"
                                          Toggled="SettingToggled" />
                            <ToggleSwitch Header="Enable Artist Enrichment (TheAudioDB)"
                                          IsOn="{x:Bind ExternalSettings.EnableArtistEnrichment, Mode=TwoWay}"
                                          Toggled="SettingToggled" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. External Providers -->
                <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="EXTERNAL PROVIDERS" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" CharacterSpacing="80" />
                        
                        <!-- MusicBrainz -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="MusicBrainz" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Music identity, release dates, track numbering &amp; fuzzy matching. (Rate-limited to 1 req/s, no key required)" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ExternalSettings.MusicBrainzEnabled, Mode=TwoWay}" Toggled="SettingToggled" VerticalAlignment="Center" />
                        </Grid>

                        <MenuFlyoutSeparator />

                        <!-- LRCLIB -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="LRCLIB" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Synchronized timestamped (.lrc) and plain text lyrics. (No key required)" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ExternalSettings.LrcLibEnabled, Mode=TwoWay}" Toggled="SettingToggled" VerticalAlignment="Center" />
                        </Grid>

                        <MenuFlyoutSeparator />

                        <!-- Cover Art Archive -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Cover Art Archive" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Internet Archive community repository for front album artwork. (No key required)" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ExternalSettings.CoverArtArchiveEnabled, Mode=TwoWay}" Toggled="SettingToggled" VerticalAlignment="Center" />
                        </Grid>

                        <MenuFlyoutSeparator />

                        <!-- TheAudioDB -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="TheAudioDB" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Artist biographies, genres, formation dates, social links, and profile photos." FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ExternalSettings.TheAudioDbEnabled, Mode=TwoWay}" Toggled="SettingToggled" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. API Credentials -->
                <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="API CREDENTIALS" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" CharacterSpacing="80" />
                        <TextBlock Text="Configure provider authentication keys. Keys are stored locally and never exposed in logs or diagnostics." FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                        
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="TheAudioDB API Key" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ExternalSettings.TheAudioDbStatusText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <PasswordBox Grid.Column="0"
                                         Header="API Key (Default public test key is '2')"
                                         Password="{x:Bind ExternalSettings.TheAudioDbApiKey, Mode=TwoWay}"
                                         PasswordRevealMode="Peek"
                                         PasswordChanged="TheAudioDbPasswordBox_PasswordChanged"
                                         PlaceholderText="Enter TheAudioDB API Key"
                                         Margin="0,0,8,0" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Height="36"
                                    Content="Test Connection"
                                    Command="{x:Bind ExternalSettings.TestTheAudioDbConnectionCommand}"
                                    IsEnabled="{x:Bind BoolToInverted(ExternalSettings.IsTestingConnection), Mode=OneWay}" />
                        </Grid>

                        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind BoolToVisibility(ExternalSettings.IsTestingConnection), Mode=OneWay}" />
                        <InfoBar IsOpen="{x:Bind ExternalSettings.IsConnectionTestVisible, Mode=OneWay}"
                                 Message="{x:Bind ExternalSettings.ConnectionTestMessage, Mode=OneWay}"
                                 Severity="{x:Bind ExternalSettings.ConnectionTestSeverity, Mode=OneWay}"
                                 IsClosable="True" />
                    </StackPanel>
                </Border>

                <!-- 4. Metadata Write Policy -->
                <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="METADATA WRITE &amp; AUTOMATION POLICY" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" CharacterSpacing="80" />
                        <TextBlock Text="Control when and how external metadata is written to local audio files." FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />

                        <ComboBox Header="Automatic Write Policy"
                                  SelectedIndex="{x:Bind ExternalSettings.WritePolicyIndex, Mode=TwoWay}"
                                  SelectionChanged="SettingSelectionChanged"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Never write automatically (Review changes before applying)" />
                            <ComboBoxItem Content="Write only when metadata is missing &amp; match is high confidence (Recommended)" />
                            <ComboBoxItem Content="Write only on high confidence matches" />
                            <ComboBoxItem Content="Always prefer online metadata" />
                        </ComboBox>

                        <ToggleSwitch Header="Write MusicBrainz IDs to file tags when available"
                                      IsOn="{x:Bind ExternalSettings.WriteExternalIdsToTags, Mode=TwoWay}"
                                      Toggled="SettingToggled" />
                        <ToggleSwitch Header="Automatically download missing album artwork"
                                      IsOn="{x:Bind ExternalSettings.AutoDownloadMissingArtwork, Mode=TwoWay}"
                                      Toggled="SettingToggled" />
                        <ToggleSwitch Header="Automatically download missing artist profile images"
                                      IsOn="{x:Bind ExternalSettings.AutoDownloadMissingArtistImages, Mode=TwoWay}"
                                      Toggled="SettingToggled" />
                        <ToggleSwitch Header="Auto-fill empty/missing metadata tags"
                                      IsOn="{x:Bind ExternalSettings.AutoFillMissingMetadata, Mode=TwoWay}"
                                      Toggled="SettingToggled" />
                        <ToggleSwitch Header="Replace existing metadata tags with online values"
                                      IsOn="{x:Bind ExternalSettings.ReplaceExistingMetadata, Mode=TwoWay}"
                                      Toggled="SettingToggled" />
                        <ToggleSwitch Header="Replace existing embedded artwork with online covers"
                                      IsOn="{x:Bind ExternalSettings.ReplaceExistingArtwork, Mode=TwoWay}"
                                      Toggled="SettingToggled" />
                    </StackPanel>
                </Border>

                <!-- 5. Two-Tier Caching & Network Rate Limits -->
                <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="CACHING &amp; NETWORK RATE LIMITS" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" CharacterSpacing="80" />
                        
                        <ToggleSwitch Header="Use cached metadata and artwork when offline"
                                      IsOn="{x:Bind ExternalSettings.UseCachedDataOffline, Mode=TwoWay}"
                                      Toggled="SettingToggled" />
                        <ToggleSwitch Header="Allow stale cached responses if provider is temporarily unavailable"
                                      IsOn="{x:Bind ExternalSettings.AllowStaleCacheOnProviderFailure, Mode=TwoWay}"
                                      Toggled="SettingToggled" />

                        <ComboBox Header="Cache Retention Duration"
                                  SelectedIndex="{x:Bind ExternalSettings.CacheRetentionDaysIndex, Mode=TwoWay}"
                                  SelectionChanged="SettingSelectionChanged"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="7 Days" />
                            <ComboBoxItem Content="30 Days (Default)" />
                            <ComboBoxItem Content="90 Days" />
                            <ComboBoxItem Content="180 Days" />
                            <ComboBoxItem Content="365 Days" />
                        </ComboBox>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBlock Text="Maximum Concurrent External Requests:" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="14" />
                            <Slider Grid.Column="1" Width="180" Minimum="1" Maximum="10" StepFrequency="1"
                                    Value="{x:Bind ExternalSettings.MaxConcurrentRequests, Mode=TwoWay}"
                                    ValueChanged="SettingSliderChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 6. Online Library Scan Preferences -->
                <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="ONLINE SCAN PREFERENCES" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" CharacterSpacing="80" />
                        <TextBlock Text="Configure targeted filters for automatic and manual library enrichment scan passes." FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />

                        <CheckBox Content="Scan entire library" IsChecked="{x:Bind ExternalSettings.ScanEntireLibrary, Mode=TwoWay}" Click="SettingCheckBoxClicked" />
                        <CheckBox Content="Scan only tracks with missing metadata" IsChecked="{x:Bind ExternalSettings.ScanOnlyMissingMetadata, Mode=TwoWay}" Click="SettingCheckBoxClicked" />
                        <CheckBox Content="Scan only tracks with missing artwork" IsChecked="{x:Bind ExternalSettings.ScanOnlyMissingArtwork, Mode=TwoWay}" Click="SettingCheckBoxClicked" />
                        <CheckBox Content="Scan only tracks with missing lyrics" IsChecked="{x:Bind ExternalSettings.ScanOnlyMissingLyrics, Mode=TwoWay}" Click="SettingCheckBoxClicked" />
                        <CheckBox Content="Recheck previously failed online matches" IsChecked="{x:Bind ExternalSettings.RecheckPreviouslyFailedMatches, Mode=TwoWay}" Click="SettingCheckBoxClicked" />
                        <CheckBox Content="Recheck ambiguous online matches" IsChecked="{x:Bind ExternalSettings.RecheckAmbiguousMatches, Mode=TwoWay}" Click="SettingCheckBoxClicked" />
                    </StackPanel>
                </Border>
            </StackPanel>

                <!-- ============================================================= -->
                <!-- ENGINE DIAGNOSTIC HARNESS                                     -->
                <!-- ============================================================= -->
                <!-- UI-ST-02: used to be a neon-green "Ignite Main Engines (Run
                     Static Fire)" button floating outside the settings column
                     with no explanation of what it does. Restyled as a normal
                     action, moved inside the settings stack, and given a caption.
                     The console keeps its deliberate terminal look (#111111 /
                     green on purpose). -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Engine Diagnostic Harness" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Runs an internal BASS engine self-test and prints the report to the console below. No library files are modified."
                               FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                    <Button Content="Run Engine Diagnostics (Static Fire)"
                            Command="{x:Bind ViewModel.RunStaticFireCommand}"
                            Width="300" Height="40"
                            FontWeight="SemiBold" />

                    <TextBlock Text="Console Log Output" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                    <ScrollViewer Height="300" Background="#111111" Padding="12" CornerRadius="4">
                        <TextBlock Text="{x:Bind ViewModel.ConsoleOutput, Mode=OneWay}"
                                   TextWrapping="Wrap" FontFamily="Consolas" Foreground="#00FF66"/>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
