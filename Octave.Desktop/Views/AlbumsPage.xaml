<Page
    x:Class="Octave_Desktop.Views.AlbumsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Octave.Core.Models"
    xmlns:converters="using:Octave_Desktop.Converters"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <converters:ArtworkPathConverter x:Key="ArtworkPathConverter" />
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Albums" FontSize="28" FontWeight="Bold" Margin="0,0,0,24" Foreground="White" />

        <GridView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="GridView_ItemClick">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:Album">
                    <Grid Width="160" Height="220" Margin="8" Padding="8" Background="#1E1E1E" CornerRadius="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Square Artwork Image -->
                        <Grid Grid.Row="0" Width="144" Height="144" Background="#2E2E2E" CornerRadius="6">
                            <Image Source="{x:Bind ArtworkUrl, Converter={StaticResource ArtworkPathConverter}}" 
                                   Width="144" 
                                   Height="144" 
                                   Stretch="UniformToFill" />
                        </Grid>

                        <!-- Title -->
                        <TextBlock Grid.Row="1" Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" VerticalAlignment="Top"/>

                        <!-- Artist -->
                        <TextBlock Grid.Row="2" Text="{x:Bind ArtistName}" FontSize="12" Foreground="#888888" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom"/>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
