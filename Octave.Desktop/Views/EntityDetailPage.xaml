<Page
    x:Class="Octave_Desktop.Views.EntityDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Octave.Core.Models"
    xmlns:local="using:Octave_Desktop.Views"
    xmlns:converters="using:Octave_Desktop.Converters"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <converters:ArtworkPathConverter x:Key="ArtworkPathConverter" />
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Upper Banner Section -->
        <Grid Grid.Row="0" Margin="-24,-24,-24,24" Padding="32,64,32,32" Background="{StaticResource CardHoverBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Artwork -->
            <Border Grid.Column="0" Width="232" Height="232" CornerRadius="8" Background="#222222" Margin="0,0,32,0">
                <Image Source="{x:Bind ViewModel.ArtworkUrl, Mode=OneWay, Converter={StaticResource ArtworkPathConverter}, ConverterParameter=Large}" Stretch="UniformToFill" />
            </Border>

            <!-- Text details -->
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                <TextBlock Text="ALBUM" FontSize="12" FontWeight="Bold" Foreground="#AAAAAA" />
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="64" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,8,0,8" />
                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" FontSize="16" Foreground="#AAAAAA" Margin="0,0,0,24" />
                
                <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.PlayAllCommand}" Style="{StaticResource PrimaryPlayButtonStyle}">
                        <FontIcon Glyph="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="24" />
                    </Button>
                    
                    <Button Click="BackButton_Click" Style="{StaticResource GhostIconButtonStyle}">
                        <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" Foreground="#AAAAAA" FontSize="20" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Track List Section -->
        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}"
                  IsItemClickEnabled="True"
                  ItemClick="ListView_ItemClick"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                    <Grid Padding="16,8" Background="Transparent" Height="56" RightTapped="TrackRow_RightTapped" CornerRadius="4" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>

                        <!-- Play/Pause Button -->
                        <Button Grid.Column="0"
                                Click="PlayButton_Click"
                                Loaded="PlayButton_Loaded"
                                DataContextChanged="PlayButton_DataContextChanged"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Padding="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE768;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="White"/>
                        </Button>

                        <!-- Title -->
                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>

                        <!-- Local/Cloud Provider Status -->
                        <FontIcon Grid.Column="2" 
                                  Glyph="{x:Bind local:EntityDetailPage.GetProviderGlyph(Provider)}" 
                                  FontFamily="Segoe MDL2 Assets" 
                                  FontSize="14" 
                                  Foreground="#888888" 
                                  Margin="12,0" 
                                  VerticalAlignment="Center"/>

                        <!-- Artist -->
                        <TextBlock Grid.Column="3" Text="{x:Bind ArtistName}" VerticalAlignment="Center" Foreground="#888888" TextTrimming="CharacterEllipsis"/>

                        <!-- Duration -->
                        <TextBlock Grid.Column="4" Text="{x:Bind local:EntityDetailPage.FormatDuration(DurationSeconds)}" VerticalAlignment="Center" Foreground="#888888" HorizontalAlignment="Right" Margin="0,0,8,0"/>

                        <!-- More Menu -->
                        <Button Grid.Column="5" 
                                Background="Transparent" 
                                BorderBrush="Transparent" 
                                Padding="4"
                                Click="MoreMenuButton_Click"
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#888888"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
