<Page
    x:Class="Octave_Desktop.Views.EntityDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Octave.Core.Models"
    xmlns:local="using:Octave_Desktop.Views"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Upper Banner Section -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Artwork / Icon Placeholder -->
            <Grid Grid.Column="0" Width="120" Height="120" Background="#1E1E1E" CornerRadius="8" Margin="0,0,24,0">
                <FontIcon Glyph="&#xE93C;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="#444444" />
            </Grid>

            <!-- Text details -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" FontSize="16" Foreground="#888888" Margin="0,4,0,16" />
                
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Play" 
                            Command="{x:Bind ViewModel.PlayAllCommand}" 
                            Style="{StaticResource AccentButtonStyle}" 
                            Padding="24,8" />
                    
                    <Button Content="Back" 
                            Click="BackButton_Click" 
                            Padding="16,8" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Track List Section -->
        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}"
                  IsItemClickEnabled="True"
                  ItemClick="ListView_ItemClick"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                    <Grid Padding="12,8" Background="Transparent" Height="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>

                        <!-- Play/Pause Button -->
                        <Button Grid.Column="0"
                                Click="PlayButton_Click"
                                Loaded="PlayButton_Loaded"
                                DataContextChanged="PlayButton_DataContextChanged"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Padding="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE768;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="White"/>
                        </Button>

                        <!-- Title -->
                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>

                        <!-- Local/Cloud Provider Status -->
                        <FontIcon Grid.Column="2" 
                                  Glyph="{x:Bind local:EntityDetailPage.GetProviderGlyph(Provider)}" 
                                  FontFamily="Segoe MDL2 Assets" 
                                  FontSize="14" 
                                  Foreground="#888888" 
                                  Margin="12,0" 
                                  VerticalAlignment="Center"/>

                        <!-- Artist -->
                        <TextBlock Grid.Column="3" Text="{x:Bind ArtistName}" VerticalAlignment="Center" Foreground="#888888" TextTrimming="CharacterEllipsis"/>

                        <!-- Duration -->
                        <TextBlock Grid.Column="4" Text="{x:Bind local:EntityDetailPage.FormatDuration(DurationSeconds)}" VerticalAlignment="Center" Foreground="#888888" HorizontalAlignment="Right"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
