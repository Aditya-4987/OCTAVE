<Page
    x:Class="Octave_Desktop.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Octave.Core.Models"
    xmlns:vm="using:Octave_Desktop.ViewModels"
    xmlns:converters="using:Octave_Desktop.Converters"
    xmlns:local="using:Octave_Desktop.Views"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <converters:ArtworkPathConverter x:Key="ArtworkPathConverter" />
        <Storyboard x:Key="SkeletonPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="SkeletonPanel" Storyboard.TargetProperty="Opacity"
                             From="0.35" To="0.85" Duration="0:0:0.9" />
        </Storyboard>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16" Padding="32,48,32,0">
            <TextBlock Text="Songs Library" FontSize="36" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
            <ComboBox Header="" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}"
                      HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="150">
                <ComboBoxItem Content="Sort: Title" />
                <ComboBoxItem Content="Sort: Artist" />
                <ComboBoxItem Content="Sort: Album" />
                <ComboBoxItem Content="Sort: Date Added" />
                <ComboBoxItem Content="Sort: Duration" />
            </ComboBox>
        </Grid>

        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  IsItemClickEnabled="True"
                  ItemClick="ListView_ItemClick"
                  SelectionMode="None"
                  Padding="32,0,32,32">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LibraryTrackItem">
                    <Grid Padding="16,8" Background="Transparent" Height="56" RightTapped="TrackRow_RightTapped" CornerRadius="4" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>

                        <!-- Play/Pause Button -->
                        <Button Grid.Column="0"
                                Click="PlayButton_Click"
                                Loaded="PlayButton_Loaded"
                                DataContextChanged="PlayButton_DataContextChanged"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Padding="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE768;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="White"/>
                        </Button>

                        <!-- Album Art (NF-37: token resolved by the view model from the
                             track's album; Track carries no artwork, so binding SourceUri
                             would always render the placeholder). Sits immediately right
                             of the play/pause button. -->
                        <Border Grid.Column="1" CornerRadius="4" Width="40" Height="40" Margin="0,0,4,0"
                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Image Source="{x:Bind ArtworkUrl, Converter={StaticResource ArtworkPathConverter}, ConverterParameter=40, Mode=OneWay}" Stretch="UniformToFill"/>
                        </Border>

                        <!-- Title -->
                        <TextBlock Grid.Column="2" Text="{x:Bind Title}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>

                        <!-- Local/Cloud Provider Status -->
                        <FontIcon Grid.Column="3"
                                  Glyph="{x:Bind local:LibraryPage.GetProviderGlyph(Provider)}"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="14"
                                  Foreground="#888888"
                                  Margin="12,0"
                                  VerticalAlignment="Center"/>

                        <!-- Artist -->
                        <TextBlock Grid.Column="4" Text="{x:Bind ArtistName}" VerticalAlignment="Center" Foreground="#888888" TextTrimming="CharacterEllipsis"/>

                        <!-- Duration -->
                        <TextBlock Grid.Column="5" Text="{x:Bind local:LibraryPage.FormatDuration(DurationSeconds)}" VerticalAlignment="Center" Foreground="#888888" HorizontalAlignment="Right" Margin="0,0,8,0"/>

                        <!-- More Menu -->
                        <Button Grid.Column="6"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Padding="4"
                                Click="MoreMenuButton_Click"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#888888"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Skeleton placeholder shown while the library loads -->
        <StackPanel x:Name="SkeletonPanel" Grid.Row="1" Spacing="10" VerticalAlignment="Top"
                    Visibility="{x:Bind VisibleWhen(ViewModel.IsLoading), Mode=OneWay}">
            <Border Height="44" CornerRadius="6" Background="#18FFFFFF" />
            <Border Height="44" CornerRadius="6" Background="#18FFFFFF" />
            <Border Height="44" CornerRadius="6" Background="#18FFFFFF" />
            <Border Height="44" CornerRadius="6" Background="#18FFFFFF" />
            <Border Height="44" CornerRadius="6" Background="#18FFFFFF" />
            <Border Height="44" CornerRadius="6" Background="#18FFFFFF" />
            <Border Height="44" CornerRadius="6" Background="#18FFFFFF" />
        </StackPanel>
    </Grid>
</Page>
