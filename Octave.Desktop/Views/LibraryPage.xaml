<Page
    x:Class="Octave_Desktop.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Octave.Core.Models"
    xmlns:local="using:Octave_Desktop.Views"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <Storyboard x:Key="SkeletonPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="SkeletonPanel" Storyboard.TargetProperty="Opacity"
                             From="0.35" To="0.85" Duration="0:0:0.9" />
        </Storyboard>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,24">
            <TextBlock Text="Songs Library" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
            <ComboBox Header="" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}"
                      HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="150">
                <ComboBoxItem Content="Sort: Title" />
                <ComboBoxItem Content="Sort: Artist" />
                <ComboBoxItem Content="Sort: Album" />
                <ComboBoxItem Content="Sort: Date Added" />
                <ComboBoxItem Content="Sort: Duration" />
            </ComboBox>
        </Grid>

        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  IsItemClickEnabled="True"
                  ItemClick="ListView_ItemClick"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                    <Grid Padding="12,8" Background="Transparent" Height="52" RightTapped="TrackRow_RightTapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>

                        <!-- Play/Pause Button -->
                        <Button Grid.Column="0"
                                Click="PlayButton_Click"
                                Loaded="PlayButton_Loaded"
                                DataContextChanged="PlayButton_DataContextChanged"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Padding="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE768;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="White"/>
                        </Button>

                        <!-- Title -->
                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>

                        <!-- Local/Cloud Provider Status -->
                        <FontIcon Grid.Column="2" 
                                  Glyph="{x:Bind local:LibraryPage.GetProviderGlyph(Provider)}" 
                                  FontFamily="Segoe MDL2 Assets" 
                                  FontSize="14" 
                                  Foreground="#888888" 
                                  Margin="12,0" 
                                  VerticalAlignment="Center"/>

                        <!-- Artist -->
                        <TextBlock Grid.Column="3" Text="{x:Bind ArtistName}" VerticalAlignment="Center" Foreground="#888888" TextTrimming="CharacterEllipsis"/>

                        <!-- Duration -->
                        <TextBlock Grid.Column="4" Text="{x:Bind local:LibraryPage.FormatDuration(DurationSeconds)}" VerticalAlignment="Center" Foreground="#888888" HorizontalAlignment="Right"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Skeleton placeholder shown while the library loads -->
        <StackPanel x:Name="SkeletonPanel" Grid.Row="1" Spacing="10" VerticalAlignment="Top"
                    Visibility="{x:Bind VisibleWhen(ViewModel.IsLoading), Mode=OneWay}">
            <Border Height="44" CornerRadius="6" Background="#18FFFFFF" />
            <Border Height="44" CornerRadius="6" Background="#18FFFFFF" />
            <Border Height="44" CornerRadius="6" Background="#18FFFFFF" />
            <Border Height="44" CornerRadius="6" Background="#18FFFFFF" />
            <Border Height="44" CornerRadius="6" Background="#18FFFFFF" />
            <Border Height="44" CornerRadius="6" Background="#18FFFFFF" />
            <Border Height="44" CornerRadius="6" Background="#18FFFFFF" />
        </StackPanel>
    </Grid>
</Page>
