<Page
    x:Class="Octave_Desktop.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Octave.Core.Models"
    xmlns:vm="using:Octave_Desktop.ViewModels"
    xmlns:converters="using:Octave_Desktop.Converters"
    xmlns:local="using:Octave_Desktop.Views"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <converters:ArtworkPathConverter x:Key="ArtworkPathConverter" />
        <Storyboard x:Key="SkeletonPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="SkeletonPanel" Storyboard.TargetProperty="Opacity"
                             From="0.35" To="0.85" Duration="0:0:0.9" />
        </Storyboard>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16" Padding="32,48,32,0">
            <!-- Normal Header -->
            <Grid Visibility="{x:Bind NormalHeaderVisibility(ViewModel.IsSelectionMode), Mode=OneWay}">
                <TextBlock Text="Songs Library" FontSize="36" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Click="ToggleSelectionMode_Click" Style="{StaticResource GhostIconButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE762;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                            <TextBlock Text="Select" />
                        </StackPanel>
                    </Button>
                    <ComboBox Header="" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}"
                              MinWidth="150" VerticalAlignment="Center">
                        <ComboBoxItem Content="Sort: Title" />
                        <ComboBoxItem Content="Sort: Artist" />
                        <ComboBoxItem Content="Sort: Album" />
                        <ComboBoxItem Content="Sort: Date Added" />
                        <ComboBoxItem Content="Sort: Duration" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Selection Mode Command Bar -->
            <Grid Visibility="{x:Bind SelectionHeaderVisibility(ViewModel.IsSelectionMode), Mode=OneWay}">
                <TextBlock x:Name="SelectedCountTextBlock" Text="0 songs selected" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="PlaySelectedBtn" Click="PlaySelected_Click" Style="{StaticResource PrimaryPlayButtonStyle}" Height="36" Width="Auto" Padding="16,0" CornerRadius="18">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                            <TextBlock Text="Play" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="QueueSelectedBtn" Click="AddSelectedToQueue_Click" Style="{StaticResource GhostIconButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                            <TextBlock Text="Add to Queue" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PlaylistSelectedBtn" Click="AddSelectedToPlaylist_Click" Style="{StaticResource GhostIconButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE90B;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                            <TextBlock Text="Add to Playlist" />
                        </StackPanel>
                    </Button>
                    <Button Content="Select All" Click="SelectAll_Click" Style="{StaticResource GhostIconButtonStyle}" />
                    <Button Content="Done" Click="ExitSelectionMode_Click" Style="{StaticResource GhostIconButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>

        <ListView Grid.Row="1"
                  x:Name="TracksListView"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  IsItemClickEnabled="{x:Bind IsClickEnabled(ViewModel.IsSelectionMode), Mode=OneWay}"
                  ItemClick="ListView_ItemClick"
                  SelectionMode="{x:Bind ResolveSelectionMode(ViewModel.IsSelectionMode), Mode=OneWay}"
                  SelectionChanged="TracksListView_SelectionChanged"
                  Padding="32,0,32,32">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LibraryTrackItem">
                    <Grid Padding="16,8" Background="Transparent" Height="56" RightTapped="TrackRow_RightTapped" CornerRadius="6" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>

                        <!-- Play/Pause Button -->
                        <Button Grid.Column="0"
                                Click="PlayButton_Click"
                                Loaded="PlayButton_Loaded"
                                DataContextChanged="PlayButton_DataContextChanged"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Padding="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE768;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </Button>

                        <!-- Album Art -->
                        <Border Grid.Column="1" CornerRadius="4" Width="40" Height="40" Margin="0,0,4,0"
                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Image Source="{x:Bind ArtworkUrl, Converter={StaticResource ArtworkPathConverter}, ConverterParameter=40, Mode=OneWay}" Stretch="UniformToFill"/>
                        </Border>

                        <!-- Title -->
                        <TextBlock Grid.Column="2" Text="{x:Bind Title}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>

                        <!-- Artist -->
                        <TextBlock Grid.Column="3" Text="{x:Bind ArtistName}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>

                        <!-- Duration -->
                        <TextBlock Grid.Column="4" Text="{x:Bind local:LibraryPage.FormatDuration(DurationSeconds)}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" Margin="0,0,8,0"/>

                        <!-- Favorite Button -->
                        <Button Grid.Column="5"
                                Click="FavoriteButton_Click"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Padding="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="{Binding IsFavorite, Converter={StaticResource FavoriteToolTipConverter}}">
                            <FontIcon Glyph="{Binding IsFavorite, Converter={StaticResource FavoriteGlyphConverter}}"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{Binding IsFavorite, Converter={StaticResource FavoriteBrushConverter}}"/>
                        </Button>

                        <!-- More Menu -->
                        <Button Grid.Column="6"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Padding="4"
                                Click="MoreMenuButton_Click"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Skeleton placeholder shown while the library loads -->
        <StackPanel x:Name="SkeletonPanel" Grid.Row="1" Spacing="10" VerticalAlignment="Top" Padding="32,0,32,0"
                    Visibility="{x:Bind VisibleWhen(ViewModel.IsLoading), Mode=OneWay}">
            <Border Height="44" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}" />
            <Border Height="44" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}" />
            <Border Height="44" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}" />
            <Border Height="44" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}" />
            <Border Height="44" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}" />
            <Border Height="44" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}" />
            <Border Height="44" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}" />
        </StackPanel>
    </Grid>
</Page>
