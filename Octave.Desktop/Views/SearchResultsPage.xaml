<Page
    x:Class="Octave_Desktop.Views.SearchResultsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Octave.Core.Models"
    xmlns:local="using:Octave_Desktop.Views"
    xmlns:converters="using:Octave_Desktop.Converters"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <converters:ArtworkPathConverter x:Key="ArtworkPathConverter" />
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="SearchQueryText" FontSize="28" FontWeight="Bold" Margin="0,0,0,24" Foreground="White" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="32">
                <!-- Section 1: Tracks -->
                <StackPanel x:Name="TracksSection" Visibility="{x:Bind VisibilityFromCount(ViewModel.Tracks.Count), Mode=OneWay}">
                    <TextBlock Text="Tracks" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,12" />
                    <ListView ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}"
                              IsItemClickEnabled="True"
                              ItemClick="ListView_ItemClick"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Track">
                                <Grid Padding="12,8" Background="Transparent" Height="52">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Play/Pause Button -->
                                    <Button Grid.Column="0"
                                            Click="PlayButton_Click"
                                            Loaded="PlayButton_Loaded"
                                            DataContextChanged="PlayButton_DataContextChanged"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Padding="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE768;"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="14"
                                                  Foreground="White"/>
                                    </Button>

                                    <!-- Title -->
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>

                                    <!-- Local/Cloud Provider Status -->
                                    <FontIcon Grid.Column="2" 
                                              Glyph="{x:Bind local:SearchResultsPage.GetProviderGlyph(Provider)}" 
                                              FontFamily="Segoe MDL2 Assets" 
                                              FontSize="14" 
                                              Foreground="#888888" 
                                              Margin="12,0" 
                                              VerticalAlignment="Center"/>

                                    <!-- Artist -->
                                    <TextBlock Grid.Column="3" Text="{x:Bind ArtistName}" VerticalAlignment="Center" Foreground="#888888" TextTrimming="CharacterEllipsis"/>

                                    <!-- Album -->
                                    <TextBlock Grid.Column="4" Text="{x:Bind AlbumTitle}" VerticalAlignment="Center" Foreground="#888888" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>

                                    <!-- Duration -->
                                    <TextBlock Grid.Column="5" Text="{x:Bind local:SearchResultsPage.FormatDuration(DurationSeconds)}" VerticalAlignment="Center" Foreground="#888888" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- Section 2: Albums -->
                <StackPanel x:Name="AlbumsSection" Visibility="{x:Bind VisibilityFromCount(ViewModel.Albums.Count), Mode=OneWay}">
                    <TextBlock Text="Albums" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,12" />
                    <GridView ItemsSource="{x:Bind ViewModel.Albums, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="AlbumGrid_ItemClick">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:Album">
                                <Grid Width="160" Height="220" Margin="8" Padding="8" Background="#1E1E1E" CornerRadius="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Square Artwork Image -->
                                    <Grid Grid.Row="0" Width="144" Height="144" Background="#2E2E2E" CornerRadius="6">
                                        <Image Source="{x:Bind ArtworkUrl, Converter={StaticResource ArtworkPathConverter}}" 
                                               Width="144" 
                                               Height="144" 
                                               Stretch="UniformToFill" />
                                    </Grid>

                                    <!-- Title -->
                                    <TextBlock Grid.Row="1" Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" VerticalAlignment="Top"/>

                                    <!-- Artist -->
                                    <TextBlock Grid.Row="2" Text="{x:Bind ArtistName}" FontSize="12" Foreground="#888888" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom"/>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!-- Section 3: Artists -->
                <StackPanel x:Name="ArtistsSection" Visibility="{x:Bind VisibilityFromCount(ViewModel.Artists.Count), Mode=OneWay}">
                    <TextBlock Text="Artists" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,12" />
                    <GridView ItemsSource="{x:Bind ViewModel.Artists, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="ArtistGrid_ItemClick">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:Artist">
                                <Grid Width="160" Height="210" Margin="8" Padding="8" Background="#1E1E1E" CornerRadius="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Circular Artwork Image -->
                                    <Border Grid.Row="0" Width="100" Height="100" CornerRadius="50" HorizontalAlignment="Center" Background="#222222">
                                        <Image Source="{x:Bind ArtworkUrl, Mode=OneWay, Converter={StaticResource ArtworkPathConverter}, ConverterParameter=Artist}" Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- Name -->
                                    <TextBlock Grid.Row="1" Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!-- No Results fallback -->
                <TextBlock Text="No matches found." 
                           FontSize="16" 
                           Foreground="#888888" 
                           HorizontalAlignment="Center" 
                           Margin="0,48,0,0"
                           Visibility="{x:Bind NoResultsVisibility(ViewModel.Tracks.Count, ViewModel.Albums.Count, ViewModel.Artists.Count), Mode=OneWay}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
