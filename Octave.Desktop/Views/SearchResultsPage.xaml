<Page
    x:Class="Octave_Desktop.Views.SearchResultsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Octave.Core.Models"
    xmlns:local="using:Octave_Desktop.Views"
    xmlns:converters="using:Octave_Desktop.Converters"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <converters:ArtworkPathConverter x:Key="ArtworkPathConverter" />
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="SearchQueryText" FontSize="36" FontWeight="Bold" Margin="0,0,0,16" Padding="32,48,32,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="32">
                <!-- Section 1: Tracks -->
                <StackPanel x:Name="TracksSection" Visibility="{x:Bind VisibilityFromCount(ViewModel.Tracks.Count), Mode=OneWay}">
                    <TextBlock Text="Tracks" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,0,12" />
                    <ListView ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}"
                              IsItemClickEnabled="True"
                              ItemClick="ListView_ItemClick"
                              SelectionMode="None"
                              Padding="32,0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Track">
                                <Grid Padding="16,8" Background="Transparent" Height="56" RightTapped="TrackRow_RightTapped" CornerRadius="6" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Play/Pause Button -->
                                    <Button Grid.Column="0"
                                            Click="PlayButton_Click"
                                            Loaded="PlayButton_Loaded"
                                            DataContextChanged="PlayButton_DataContextChanged"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Padding="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE768;"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="14"
                                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </Button>

                                    <!-- Title -->
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>

                                    <!-- Artist -->
                                    <TextBlock Grid.Column="2" Text="{x:Bind ArtistName}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>

                                    <!-- Album -->
                                    <TextBlock Grid.Column="3" Text="{x:Bind AlbumTitle}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>

                                    <!-- Duration -->
                                    <TextBlock Grid.Column="4" Text="{x:Bind local:SearchResultsPage.FormatDuration(DurationSeconds)}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" Margin="0,0,8,0"/>

                                    <!-- Favorite Button -->
                                    <Button Grid.Column="5"
                                            Click="FavoriteButton_Click"
                                            Loaded="FavoriteButton_Loaded"
                                            DataContextChanged="FavoriteButton_DataContextChanged"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Padding="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Favorite">
                                        <FontIcon Glyph="&#xEB51;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </Button>

                                    <!-- More Menu -->
                                    <Button Grid.Column="6" 
                                            Background="Transparent" 
                                            BorderBrush="Transparent" 
                                            Padding="4"
                                            Click="MoreMenuButton_Click"
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- Section 2: Albums -->
                <StackPanel x:Name="AlbumsSection" Visibility="{x:Bind VisibilityFromCount(ViewModel.Albums.Count), Mode=OneWay}">
                    <TextBlock Text="Albums" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="32,0,0,12" />
                    <GridView ItemsSource="{x:Bind ViewModel.Albums, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="AlbumGrid_ItemClick"
                              Padding="32,0"
                              ItemContainerStyle="{StaticResource CleanGridViewItemStyle}">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:Album">
                                <Grid Width="160" Height="220" Style="{StaticResource StandardCardStyle}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="BorderBrush">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SystemControlHighlightAccentBrush}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Square Artwork Image -->
                                    <Border Grid.Row="0" Width="136" Height="136" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Margin="0,0,0,12">
                                        <Image Source="{x:Bind ArtworkUrl, Converter={StaticResource ArtworkPathConverter}}" Stretch="UniformToFill" />
                                    </Border>

                                    <!-- Title -->
                                    <TextBlock Grid.Row="1" Text="{x:Bind Title}" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />

                                    <!-- Artist -->
                                    <TextBlock Grid.Row="2" Text="{x:Bind ArtistName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!-- Section 3: Artists -->
                <StackPanel x:Name="ArtistsSection" Visibility="{x:Bind VisibilityFromCount(ViewModel.Artists.Count), Mode=OneWay}">
                    <TextBlock Text="Artists" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="32,0,0,12" />
                    <GridView ItemsSource="{x:Bind ViewModel.Artists, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="ArtistGrid_ItemClick"
                              Padding="32,0"
                              ItemContainerStyle="{StaticResource CleanGridViewItemStyle}">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:Artist">
                                <Grid Width="160" Height="210" Style="{StaticResource StandardCardStyle}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="BorderBrush">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SystemControlHighlightAccentBrush}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Circular Artwork Image -->
                                    <Border Grid.Row="0" Width="120" Height="120" CornerRadius="60" HorizontalAlignment="Center" Background="{ThemeResource LayerFillColorDefaultBrush}" Margin="0,0,0,12">
                                        <Image Source="{x:Bind ArtworkUrl, Mode=OneTime, Converter={StaticResource ArtworkPathConverter}, ConverterParameter=Artist}" Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- Name -->
                                    <TextBlock Grid.Row="1" Text="{x:Bind Name}" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!-- Section 4: Playlists -->
                <StackPanel x:Name="PlaylistsSection" Visibility="{x:Bind VisibilityFromCount(ViewModel.Playlists.Count), Mode=OneWay}">
                    <TextBlock Text="Playlists" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="32,0,0,12" />
                    <GridView ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="PlaylistGrid_ItemClick"
                              Padding="32,0"
                              ItemContainerStyle="{StaticResource CleanGridViewItemStyle}">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:Playlist">
                                <Grid Width="160" Height="210" Style="{StaticResource StandardCardStyle}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="BorderBrush">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SystemControlHighlightAccentBrush}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Playlist Icon Container -->
                                    <Border Grid.Row="0" Width="120" Height="120" CornerRadius="8" HorizontalAlignment="Center" Background="{ThemeResource LayerFillColorDefaultBrush}" Margin="0,0,0,12">
                                        <FontIcon Glyph="&#xE90B;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Title & Track Count -->
                                    <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind local:SearchResultsPage.TrackCountText(TrackCount)}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!-- No Results fallback -->
                <TextBlock Text="No matches found." 
                           FontSize="16" 
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                           HorizontalAlignment="Center" 
                           Margin="0,48,0,0"
                           Visibility="{x:Bind NoResultsVisibility(ViewModel.Tracks.Count, ViewModel.Albums.Count, ViewModel.Artists.Count, ViewModel.Playlists.Count), Mode=OneWay}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
