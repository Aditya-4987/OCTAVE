<Page
    x:Class="Octave_Desktop.Views.GenresPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Genres" FontSize="28" FontWeight="Bold" Margin="0,0,0,24" Foreground="White" />

        <GridView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="GridView_ItemClick">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Grid Width="180" Height="90" Margin="8" Padding="16" Background="#1E1E1E" CornerRadius="8">
                        <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                  Foreground="#888888" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <TextBlock Text="{x:Bind}" FontWeight="SemiBold" FontSize="16" Foreground="White"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" />
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
