<Page
    x:Class="Octave_Desktop.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Octave.Core.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="TrackCardTemplate" x:DataType="models:Track">
            <Grid Width="160" Height="220" RightTapped="TrackCard_RightTapped" 
                  PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                  Style="{StaticResource StandardCardStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Width="136" Height="136" Margin="0,0,0,12">
                    <!-- Fallback -->
                    <Border CornerRadius="4" Background="{ThemeResource SystemControlHighlightAccentBrush}" Opacity="0.3">
                        <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" />
                    </Border>
                    <!-- Artwork (if available) -->
                    <!-- We assume Track has an ArtworkUrl property, but if not we might need to bind to it or load it. For now, this is standard UI. -->
                </Grid>
                <TextBlock Grid.Row="1" Text="{x:Bind Title}" FontSize="14" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="2" Text="{x:Bind ArtistName}" FontSize="12" Foreground="#AAAAAA" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32,48,32,32" Spacing="32">
            <!-- Header Section -->
            <StackPanel Spacing="8">
                <TextBlock Text="Welcome back" FontSize="36" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="Jump back into your library." FontSize="16" Foreground="#AAAAAA" />
            </StackPanel>

            <TextBlock Text="Nothing here yet. Play some music, add favorites, or scan a folder."
                       Foreground="#888888"
                       Visibility="{x:Bind AllEmptyVisibility(ViewModel.RecentlyPlayed.Count, ViewModel.MostPlayed.Count, ViewModel.LastAdded.Count, ViewModel.Favorites.Count), Mode=OneWay}" />

            <!-- Recently Played -->
            <StackPanel Spacing="12" Visibility="{x:Bind SectionVisibility(ViewModel.RecentlyPlayed.Count), Mode=OneWay}">
                <TextBlock Text="Recently Played" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                <GridView ItemsSource="{x:Bind ViewModel.RecentlyPlayed, Mode=OneWay}"
                          ItemTemplate="{StaticResource TrackCardTemplate}"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="Recently_ItemClick"
                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ItemContainerStyle="{StaticResource CleanGridViewItemStyle}" />
            </StackPanel>

            <!-- Most Played -->
            <StackPanel Spacing="12" Visibility="{x:Bind SectionVisibility(ViewModel.MostPlayed.Count), Mode=OneWay}">
                <TextBlock Text="Most Played" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                <GridView ItemsSource="{x:Bind ViewModel.MostPlayed, Mode=OneWay}"
                          ItemTemplate="{StaticResource TrackCardTemplate}"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="Most_ItemClick"
                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ItemContainerStyle="{StaticResource CleanGridViewItemStyle}" />
            </StackPanel>

            <!-- Last Added -->
            <StackPanel Spacing="12" Visibility="{x:Bind SectionVisibility(ViewModel.LastAdded.Count), Mode=OneWay}">
                <TextBlock Text="Last Added" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                <GridView ItemsSource="{x:Bind ViewModel.LastAdded, Mode=OneWay}"
                          ItemTemplate="{StaticResource TrackCardTemplate}"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="LastAdded_ItemClick"
                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ItemContainerStyle="{StaticResource CleanGridViewItemStyle}" />
            </StackPanel>

            <!-- Favorites -->
            <StackPanel Spacing="12" Visibility="{x:Bind SectionVisibility(ViewModel.Favorites.Count), Mode=OneWay}">
                <TextBlock Text="Favorites" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                <GridView ItemsSource="{x:Bind ViewModel.Favorites, Mode=OneWay}"
                          ItemTemplate="{StaticResource TrackCardTemplate}"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="Favorites_ItemClick"
                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ItemContainerStyle="{StaticResource CleanGridViewItemStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
